@prefix sg:   <https://example.org/sanguo#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

################################################################
# 三國演義本體論 · Romance of the Three Kingdoms Ontology
# 由 data/sanguo-data.js + data/sanguo-topics.js + data/corpus-manifest.js 生成
# 生成日期：2026-11-22
################################################################

<https://example.org/sanguo>
    a owl:Ontology ;
    rdfs:label "三國演義本體論"@zh ;
    rdfs:comment "以 OWL 2 DL 描述《三國演義》的人物、勢力、地理、戰役、事件、計謀、器物、詩詞、讖緯、評點、版本與異文；每條實例盡量掛接回目出處。"@zh .

################################
# 一、類（Class）
################################
sg:Person a owl:Class ; rdfs:label "人物"@zh .
sg:Faction a owl:Class ; rdfs:label "勢力"@zh .
sg:Place a owl:Class ; rdfs:label "地理"@zh .
sg:Battle a owl:Class ; rdfs:subClassOf sg:Event ; rdfs:label "戰役"@zh .
sg:Event a owl:Class ; rdfs:label "事件"@zh .
sg:Stratagem a owl:Class ; rdfs:label "計謀"@zh .
sg:Artifact a owl:Class ; rdfs:label "器物"@zh .
sg:Prophecy a owl:Class ; rdfs:label "讖緯"@zh .
sg:Poem a owl:Class ; rdfs:label "詩詞"@zh .
sg:Edition a owl:Class ; rdfs:label "版本"@zh .
sg:Chapter a owl:Class ; rdfs:label "回目"@zh .
sg:VariantReading a owl:Class ; rdfs:label "異文"@zh .
sg:Commentary a owl:Class ; rdfs:label "評點"@zh .
sg:Critic a owl:Class ; rdfs:label "評點家"@zh .
sg:OfficialTitle a owl:Class ; rdfs:label "官職"@zh .
sg:Polity a owl:Class ; rdfs:label "政權"@zh .
sg:Genealogy a owl:Class ; rdfs:label "世系"@zh .
sg:Adaptation a owl:Class ; rdfs:label "衍生作品"@zh .
sg:EditionGap a owl:Class ; rdfs:label "版本缺口"@zh .
sg:Lord a owl:Class ; rdfs:subClassOf sg:Person ; rdfs:label "君主"@zh .
sg:Minister a owl:Class ; rdfs:subClassOf sg:Person ; rdfs:label "臣屬"@zh .
sg:General a owl:Class ; rdfs:subClassOf sg:Person ; rdfs:label "武將"@zh .
sg:Strategist a owl:Class ; rdfs:subClassOf sg:Person ; rdfs:label "謀士"@zh .
sg:City a owl:Class ; rdfs:subClassOf sg:Place ; rdfs:label "城邑"@zh .
sg:Pass a owl:Class ; rdfs:subClassOf sg:Place ; rdfs:label "關隘"@zh .
sg:Battlefield a owl:Class ; rdfs:subClassOf sg:Place ; rdfs:label "戰場"@zh .

################################
# 二、對象屬性（Object Property）
################################
sg:lordOf a owl:ObjectProperty ; rdfs:label "君臨"@zh .
sg:vassalOf a owl:ObjectProperty ; owl:inverseOf sg:lordOf ; rdfs:label "臣屬"@zh .
sg:memberOf a owl:ObjectProperty ; rdfs:label "隸屬勢力"@zh .
sg:parentOf a owl:ObjectProperty ; rdfs:label "父"@zh .
sg:childOf a owl:ObjectProperty ; owl:inverseOf sg:parentOf ; rdfs:label "子"@zh .
sg:siblingOf a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:label "兄弟 / 姊妹"@zh .
sg:spouseOf a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:label "夫妻"@zh .
sg:swornBrotherOf a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:label "結義"@zh .
sg:mentorOf a owl:ObjectProperty ; rdfs:label "師"@zh .
sg:discipleOf a owl:ObjectProperty ; owl:inverseOf sg:mentorOf ; rdfs:label "徒"@zh .
sg:foughtIn a owl:ObjectProperty ; rdfs:label "參戰"@zh .
sg:partiesIn a owl:ObjectProperty ; rdfs:label "參與方"@zh .
sg:occursAt a owl:ObjectProperty ; rdfs:label "發生於"@zh .
sg:usesStratagem a owl:ObjectProperty ; rdfs:label "用計"@zh .
sg:usedBy a owl:ObjectProperty ; rdfs:label "使用者"@zh .
sg:targetedBy a owl:ObjectProperty ; rdfs:label "計謀所向"@zh .
sg:usesArtifact a owl:ObjectProperty ; rdfs:label "持用器物"@zh .
sg:owner a owl:ObjectProperty ; rdfs:label "持有者"@zh .
sg:kills a owl:ObjectProperty ; rdfs:label "殺 / 斬"@zh .
sg:killedBy a owl:ObjectProperty ; owl:inverseOf sg:kills ; rdfs:label "被殺"@zh .
sg:successorOf a owl:ObjectProperty ; rdfs:label "繼承"@zh .
sg:descendantOf a owl:ObjectProperty, owl:TransitiveProperty ; rdfs:label "後裔"@zh .
sg:alliesWith a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:label "結盟"@zh .
sg:enemyOf a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:label "為敵"@zh .
sg:foretells a owl:ObjectProperty ; rdfs:label "預言"@zh .
sg:fulfilledBy a owl:ObjectProperty ; rdfs:label "應驗"@zh .
sg:derivedFrom a owl:ObjectProperty, owl:TransitiveProperty ; rdfs:label "衍生自"@zh .
sg:hasVariant a owl:ObjectProperty ; rdfs:label "異文對應"@zh .
sg:commentsOn a owl:ObjectProperty ; rdfs:label "評點"@zh .
sg:hasCommentary a owl:ObjectProperty ; owl:inverseOf sg:commentsOn ; rdfs:label "有評"@zh .
sg:wrote a owl:ObjectProperty ; rdfs:label "著述"@zh .
sg:inChapter a owl:ObjectProperty ; rdfs:label "見於回目"@zh .
sg:leader a owl:ObjectProperty ; rdfs:label "君主"@zh .
sg:capital a owl:ObjectProperty ; rdfs:label "都城"@zh .

################################
# 三、數據屬性（Datatype Property）
################################
sg:surname a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:givenName a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:styleName a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:sobriquet a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:birthYear a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:deathYear a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:nativePlace a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:title a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:posthumousName a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:referenceCount a owl:DatatypeProperty ; rdfs:range xsd:integer .
sg:compositionYear a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:storyYear a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:charCount a owl:DatatypeProperty ; rdfs:range xsd:integer .
sg:troopStrength a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:outcome a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:modernName a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:coordinates a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:prophecyText a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:titleText a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:contentText a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:chapterNumber a owl:DatatypeProperty ; rdfs:range xsd:integer .
sg:placeName a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:virtual a owl:DatatypeProperty ; rdfs:range xsd:boolean .
sg:description a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:artifactType a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:poemType a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:authorName a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:prophet a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:fulfilledByText a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:commenter a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:commentText a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:editionSystem a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:editionUnits a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:editionStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:holdingForm a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:gapNote a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:acquisitionPath a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:capitalName a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:period a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:placeLevel a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:userName a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:targetName a owl:DatatypeProperty ; rdfs:range xsd:string .
sg:ownerName a owl:DatatypeProperty ; rdfs:range xsd:string .

################################
# 四、章回骨架
################################
sg:ch1 a sg:Chapter ; rdfs:label "第1回 宴桃园豪杰三结义 斩黄巾英雄首立功" ; sg:chapterNumber 1 .
