################################
# 六、事件 · 計謀 · 器物
################################
sg:e1 a sg:Event ; rdfs:label "黃巾起義" ; sg:storyYear "184" ; sg:inChapter sg:ch1 ; sg:placeName "八州" ; sg:description "張角以太平道聚眾數十萬，頭裹黃巾，八州並起。朝廷解除黨禁，遣皇甫嵩、盧植等討伐，劉關張於涿郡投軍。" ; sg:virtual false .
sg:e2 a sg:Event ; rdfs:label "桃園結義" ; sg:storyYear "184" ; sg:inChapter sg:ch1 ; sg:placeName "涿郡" ; sg:description "劉關張於桃園祭告天地，結為異姓兄弟，誓「上報國家，下安黎庶」，是小說全書的情感起點。" ; sg:virtual true .
sg:e3 a sg:Event ; rdfs:label "董卓入京" ; sg:storyYear "189" ; sg:inChapter sg:ch3 ; sg:placeName "洛陽" ; sg:description "何進誅宦失敗被殺，袁紹等盡誅宦官，董卓率西涼兵入洛陽，收編何進部曲，自此專擅朝政。" ; sg:virtual false .
sg:e4 a sg:Event ; rdfs:label "廢少帝立獻帝" ; sg:storyYear "189" ; sg:inChapter sg:ch4 ; sg:placeName "洛陽" ; sg:description "董卓廢少帝劉辯為弘農王，立陳留王劉協為帝，即漢獻帝，關東諸侯由此起兵。" ; sg:virtual false .
sg:e5 a sg:Event ; rdfs:label "曹操獻刀" ; sg:storyYear "189" ; sg:inChapter sg:ch4 ; sg:placeName "洛陽" ; sg:description "曹操借王允七星寶刀入相府行刺董卓，事敗詐稱獻刀，騎馬逃出洛陽。" ; sg:virtual true .
sg:e6 a sg:Event ; rdfs:label "捉放曹" ; sg:storyYear "189" ; sg:inChapter sg:ch4 ; sg:placeName "中牟" ; sg:description "曹操逃亡途中為陳宮所擒，陳宮棄官同逃；曹操誤殺呂伯奢全家，留下「寧教我負天下人」之語。" ; sg:virtual true .
sg:e7 a sg:Event ; rdfs:label "十八路諸侯討董" ; sg:storyYear "190" ; sg:inChapter sg:ch5 ; sg:placeName "酸棗" ; sg:description "關東諸侯推袁紹為盟主，起兵討董，然各懷異心，糧草不繼，最終散去。" ; sg:virtual false .
sg:e8 a sg:Event ; rdfs:label "溫酒斬華雄" ; sg:storyYear "190" ; sg:inChapter sg:ch5 ; sg:placeName "汜水關" ; sg:description "華雄連斬聯軍數將，關羽請纓出戰，曹操溫酒相送；關羽斬華雄而歸，其酒尚溫。" ; sg:virtual true .
sg:e9 a sg:Event ; rdfs:label "三英戰呂布" ; sg:storyYear "190" ; sg:inChapter sg:ch5 ; sg:placeName "虎牢關" ; sg:description "呂布縱馬耀武，張飛、關羽、劉備先後夾攻，呂布遮攔不住，倒拖畫戟敗走。" ; sg:virtual true .
sg:e10 a sg:Event ; rdfs:label "王允連環計" ; sg:storyYear "192" ; sg:inChapter sg:ch8 ; sg:placeName "長安" ; sg:description "王允先許貂蟬於呂布，後獻於董卓，使二人反目；呂布遂與王允合謀誅董。" ; sg:virtual true .
sg:e11 a sg:Event ; rdfs:label "董卓之死" ; sg:storyYear "192" ; sg:inChapter sg:ch9 ; sg:placeName "長安" ; sg:description "董卓入朝，呂布以詔書為名將其刺死，暴屍於市；蔡邕因嘆董卓被殺。" ; sg:virtual false .
sg:e12 a sg:Event ; rdfs:label "李傕郭汜之亂" ; sg:storyYear "192" ; sg:inChapter sg:ch10 ; sg:placeName "長安" ; sg:description "李傕、郭汜聽賈詡之計反攻長安，呂布敗走，王允殉難，關中自此大亂。" ; sg:virtual false .
sg:e13 a sg:Event ; rdfs:label "曹操迎駕許都" ; sg:storyYear "196" ; sg:inChapter sg:ch14 ; sg:placeName "洛陽、許都" ; sg:description "曹操納荀彧「奉主上以從人望」之策，迎獻帝遷都許縣，自此挾天子以令諸侯。" ; sg:virtual false .
sg:e14 a sg:Event ; rdfs:label "轅門射戟" ; sg:storyYear "196" ; sg:inChapter sg:ch16 ; sg:placeName "小沛" ; sg:description "袁術遣紀靈攻劉備，呂布於轅門外百五十步射中畫戟小枝，為兩家解鬥。" ; sg:virtual true .
sg:e15 a sg:Event ; rdfs:label "呂布之死" ; sg:storyYear "198" ; sg:inChapter sg:ch19 ; sg:placeName "下邳" ; sg:description "曹操水淹下邳，呂布為部下所縛；劉備提醒曹操勿養虎遺患，呂布、陳宮、高順皆被殺。" ; sg:virtual false .
sg:e16 a sg:Event ; rdfs:label "煮酒論英雄" ; sg:storyYear "199" ; sg:inChapter sg:ch21 ; sg:placeName "許都" ; sg:description "曹操與劉備對坐煮酒，指天下英雄唯操與備；劉備借雷聲掩飾失箸，韜晦自保。" ; sg:virtual true .
sg:e17 a sg:Event ; rdfs:label "衣帶詔" ; sg:storyYear "200" ; sg:inChapter sg:ch20 ; sg:placeName "許都" ; sg:description "獻帝以血書藏衣帶中，密詔董承誅曹；事洩，董承等被誅，劉備由此反曹。" ; sg:virtual false .
sg:e18 a sg:Event ; rdfs:label "千里走單騎" ; sg:storyYear "200" ; sg:inChapter sg:ch27 ; sg:placeName "許都至古城" ; sg:description "關羽得知劉備下落，封金掛印，護送二嫂過五關斬六將，於古城與劉張重會。" ; sg:virtual true .
sg:e19 a sg:Event ; rdfs:label "官渡之戰" ; sg:storyYear "200" ; sg:inChapter sg:ch30 ; sg:placeName "官渡" ; sg:description "曹操以少勝多，火燒烏巢糧草，袁紹軍潰；此戰奠定曹操統一北方之基。" ; sg:virtual false .
sg:e20 a sg:Event ; rdfs:label "倉亭之戰" ; sg:storyYear "201" ; sg:inChapter sg:ch31 ; sg:placeName "倉亭" ; sg:description "曹操用十面埋伏之計再破袁紹，袁紹嘔血，河北震動。" ; sg:virtual false .
sg:e21 a sg:Event ; rdfs:label "三顧茅廬" ; sg:storyYear "207" ; sg:inChapter sg:ch37 ; sg:placeName "隆中" ; sg:description "劉備三赴隆中，終見諸葛亮；諸葛亮提出跨有荊益、聯吳抗曹的隆中對。" ; sg:virtual false .
sg:e22 a sg:Event ; rdfs:label "隆中對" ; sg:storyYear "207" ; sg:inChapter sg:ch38 ; sg:placeName "隆中" ; sg:description "諸葛亮縱論天下三分，先取荊州為家，再取益州為基，結好孫權，待時北伐。" ; sg:virtual true .
sg:e23 a sg:Event ; rdfs:label "火燒博望坡" ; sg:storyYear "208" ; sg:inChapter sg:ch39 ; sg:placeName "博望坡" ; sg:description "諸葛亮初用兵，以火攻伏擊夏侯惇，關張由此信服。" ; sg:virtual true .
sg:e24 a sg:Event ; rdfs:label "長坂坡之戰" ; sg:storyYear "208" ; sg:inChapter sg:ch41 ; sg:placeName "長坂坡" ; sg:description "趙雲單騎救阿斗，七進七出；張飛據水斷橋，一聲大喝退曹兵。" ; sg:virtual true .
sg:e25 a sg:Event ; rdfs:label "舌戰群儒" ; sg:storyYear "208" ; sg:inChapter sg:ch43 ; sg:placeName "柴桑" ; sg:description "諸葛亮赴江東，逐一駁倒張昭等主降派，促成孫劉聯盟。" ; sg:virtual true .
sg:e26 a sg:Event ; rdfs:label "草船借箭" ; sg:storyYear "208" ; sg:inChapter sg:ch46 ; sg:placeName "長江" ; sg:description "諸葛亮以草船趁大霧佯攻曹營，得箭十萬餘枝，周瑜自嘆不如。" ; sg:virtual true .
sg:e27 a sg:Event ; rdfs:label "苦肉計" ; sg:storyYear "208" ; sg:inChapter sg:ch46 ; sg:placeName "江東" ; sg:description "黃蓋與周瑜定苦肉計，當眾受杖，闞澤獻詐降書，為火攻鋪路。" ; sg:virtual true .
sg:e28 a sg:Event ; rdfs:label "借東風" ; sg:storyYear "208" ; sg:inChapter sg:ch49 ; sg:placeName "南屏山" ; sg:description "周瑜憂無東風，諸葛亮設壇祭風，東風大起，火攻得以實施。" ; sg:virtual true .
sg:e29 a sg:Event ; rdfs:label "赤壁之戰" ; sg:storyYear "208" ; sg:inChapter sg:ch49 ; sg:placeName "赤壁" ; sg:description "孫劉聯軍以火攻大破曹軍連環船，曹操敗走華容道，三分天下之勢初成。" ; sg:virtual false .
sg:e30 a sg:Event ; rdfs:label "華容道" ; sg:storyYear "208" ; sg:inChapter sg:ch50 ; sg:placeName "華容道" ; sg:description "曹操敗走華容道，關羽念舊日恩義，義釋曹操，回營請罪。" ; sg:virtual true .
sg:e31 a sg:Event ; rdfs:label "劉備取荊南" ; sg:storyYear "209" ; sg:inChapter sg:ch52 ; sg:placeName "荊南四郡" ; sg:description "劉備趁赤壁之勝，取長沙、零陵、桂陽、武陵四郡，黃忠、魏延來歸。" ; sg:virtual false .
sg:e32 a sg:Event ; rdfs:label "劉備入蜀" ; sg:storyYear "211" ; sg:inChapter sg:ch60 ; sg:placeName "益州" ; sg:description "劉璋迎劉備入蜀拒張魯，劉備反客為主，逐步奪取益州。" ; sg:virtual false .
sg:e33 a sg:Event ; rdfs:label "潼關之戰" ; sg:storyYear "211" ; sg:inChapter sg:ch58 ; sg:placeName "潼關" ; sg:description "馬超為父報仇，起西涼兵攻曹，曹操割鬚棄袍；後用賈詡離間計破馬韓。" ; sg:virtual false .
sg:e34 a sg:Event ; rdfs:label "落鳳坡" ; sg:storyYear "214" ; sg:inChapter sg:ch63 ; sg:placeName "落鳳坡" ; sg:description "龐統進兵雒城，中張任埋伏，歿於落鳳坡，年三十六。" ; sg:virtual true .
sg:e35 a sg:Event ; rdfs:label "濡須之戰" ; sg:storyYear "215" ; sg:inChapter sg:ch61 ; sg:placeName "濡須口" ; sg:description "孫曹相持於濡須，甘寧百騎劫曹營；曹操見吳軍整肅，嘆「生子當如孫仲謀」。" ; sg:virtual false .
sg:e36 a sg:Event ; rdfs:label "合肥之戰" ; sg:storyYear "215" ; sg:inChapter sg:ch67 ; sg:placeName "合肥" ; sg:description "張遼以八百破十萬，威震逍遙津，江東小兒聞名止啼。" ; sg:virtual false .
sg:e37 a sg:Event ; rdfs:label "定軍山之戰" ; sg:storyYear "219" ; sg:inChapter sg:ch70 ; sg:placeName "定軍山" ; sg:description "法正謀劃，黃忠居高臨下斬夏侯淵，劉備遂取漢中。" ; sg:virtual false .
sg:e38 a sg:Event ; rdfs:label "水淹七軍" ; sg:storyYear "219" ; sg:inChapter sg:ch74 ; sg:placeName "樊城" ; sg:description "漢水暴漲，關羽乘勢水淹七軍，擒于禁、斬龐德，威震華夏。" ; sg:virtual false .
sg:e39 a sg:Event ; rdfs:label "白衣渡江" ; sg:storyYear "219" ; sg:inChapter sg:ch75 ; sg:placeName "荊州" ; sg:description "呂蒙裝作商船白衣渡江，襲取荊州；糜芳、傅士仁不戰而降。" ; sg:virtual false .
sg:e40 a sg:Event ; rdfs:label "關羽之死" ; sg:storyYear "220" ; sg:inChapter sg:ch77 ; sg:placeName "麥城" ; sg:description "關羽敗走麥城，為吳軍所擒，不屈而死；孫權送首級於曹操，曹操以王禮葬之。" ; sg:virtual false .
sg:e41 a sg:Event ; rdfs:label "曹操之死" ; sg:storyYear "220" ; sg:inChapter sg:ch78 ; sg:placeName "洛陽" ; sg:description "曹操頭風病重，疑華佗欲害己而殺之，終病逝洛陽，遺令薄葬。" ; sg:virtual false .
sg:e42 a sg:Event ; rdfs:label "曹丕篡漢" ; sg:storyYear "220" ; sg:inChapter sg:ch80 ; sg:placeName "許都" ; sg:description "曹丕逼獻帝禪讓，改國號魏，東漢滅亡；獻帝被封山陽公。" ; sg:virtual false .
sg:e43 a sg:Event ; rdfs:label "夷陵之戰" ; sg:storyYear "222" ; sg:inChapter sg:ch84 ; sg:placeName "夷陵" ; sg:description "劉備為關羽報仇東征，陸遜堅守不出，火燒連營七百里，蜀軍大敗。" ; sg:virtual false .
sg:e44 a sg:Event ; rdfs:label "白帝城託孤" ; sg:storyYear "223" ; sg:inChapter sg:ch85 ; sg:placeName "白帝城" ; sg:description "劉備病篤，託孤於諸葛亮，言「若嗣子可輔則輔之，如其不才，君可自取」，諸葛亮泣誓竭股肱之力。" ; sg:virtual false .
sg:e45 a sg:Event ; rdfs:label "七擒孟獲" ; sg:storyYear "225" ; sg:inChapter sg:ch87 ; sg:placeName "南中" ; sg:description "諸葛亮南征，七擒七縱孟獲，攻心為上，南中平定。" ; sg:virtual true .
