[{"text": "千里草，何青青；十日卜，不得生", "kind": "童谣", "target": "董卓", "chapter": 9, "note": "董卓字里藏『卓』，预言其暴亡"}, {"text": "代汉者当涂高", "kind": "图谶", "target": "袁术/曹魏", "chapter": 3, "note": "袁术自谓应之而僭号；后解为魏"}, {"text": "汉行气尽，黄家当立", "kind": "图谶", "target": "黄巾", "chapter": 1, "note": "黄巾起事之谶"}, {"text": "苍天已死，黄天当立；岁在甲子，天下大吉", "kind": "童谣", "target": "黄巾", "chapter": 1, "note": "张角起兵的口号"}, {"text": "三马同槽", "kind": "梦兆", "target": "司马懿父子", "chapter": 78, "note": "曹操梦三马同槽，实指司马氏三代"}, {"text": "绯衣小儿来灭魏", "kind": "谶语", "target": "司马氏", "chapter": 109, "note": "预示司马代魏"}, {"text": "秃头小儿来灭魏，杨花飘荡落谁家", "kind": "诗谶", "target": "司马氏", "chapter": 109, "note": "暗指司马"}, {"text": "左龙右凤，飞入西川", "kind": "童谣", "target": "庞统", "chapter": 57, "note": "凤雏殒于落凤坡之谶"}, {"text": "凤凰坠羽落凤坡", "kind": "诗谶", "target": "庞统", "chapter": 63, "note": "庞统殒命之地应其号『凤雏』"}, {"text": "若要捉曹操，大刀手中擎", "kind": "童谣", "target": "关羽", "chapter": 50, "note": "赤壁后关公华容道释曹"}, {"text": "非衣小儿，岂得成人", "kind": "谶语", "target": "刘禅", "chapter": 80, "note": "暗合蜀汉后主之弱"}, {"text": "姜维死，汉亡", "kind": "谶语", "target": "姜维", "chapter": 117, "note": "蜀汉覆亡之应"}]