# ============================================================
# 《三國演義》本體論 · 完整 TBox（OWL 2 DL）
# Romance of the Three Kingdoms Ontology (sg:)
#
# 設計依據：
#   1. 參考 yejinlei《西遊記》本體 jtw_kg_ontology.ttl 範式；
#   2. 兼容《水滸傳》本體棧（sh: / Outlaws_of_the_Marsh）命名與 ID 規則；
#   3. 採用 OWL 2 DL 描述邏輯，所有類均為 owl:Class，所有屬性 rdfs:domain/rdfs:range
#      完備定義，函數屬性顯式標記 owl:FunctionalProperty，反函數/對稱/反自反/傳遞屬性
#      依語義標記，可直接導入任何 OWL 推理機（Protégé/HermiT/Pellet）；
#   4. 全局唯一主鍵規則（與水滸本體統一，跨本體可 JOIN）：
#        sg_version_xxx   文學作品版本
#        sg_person_xxx    人物
#        sg_force_xxx     政治勢力
#        sg_battle_xxx    戰役
#        sg_place_xxx     地點
#        sg_event_xxx     事件
#        sg_scholar_xxx   學者
#        sg_paper_xxx     學術成果
#        sg_adapt_xxx     衍生作品
#        sg_artifact_xxx  器物
#      版本數據隔離：所有提及/登場/收錄關係均綁定 sg_version_xxx，
#      實現「同一人物在不同版本中結局/情節差異互不覆蓋」。
# ============================================================

@prefix sg:    <http://localhost/sanguo-kg#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix bibo:  <http://purl.org/ontology/bibo/> .
@prefix sh:    <http://localhost/outlaws-kg#> .    # 水滸本體命名空間（跨本體聯動）

<http://localhost/sanguo-kg#>
        a                    owl:Ontology ;
        dct:title            "《三國演義》知識本體 · 完備 TBox（Sanguo-Yanyi Knowledge Ontology）" ;
        dct:creator          "本體論工程；語義依羅貫中《三國演義》原著，TBox 兼容水滸本體 sh: 命名棧" ;
        dct:description      "採用 OWL 2 DL，含 10 大頂級實體類、36 個子類、17 個數據屬性、24 個對象屬性（6 種三國專屬、18 種與水滸通用），支持多版本數據隔離與文史互證。" ;
        owl:versionInfo      "3.0-complete" ;
        owl:imports          <http://www.w3.org/2004/02/skos/core> .

# ============================================================
# 〇、根類
# ============================================================
sg:Thing  a  owl:Class ;
  rdfs:label "事物（頂層）" .

# ============================================================
# 一、文學作品類（sg:LiteraryWork）· version_id 全局主鍵
#    核心子類：古本系統 / 評點改造本 / 現代整理本 / 續書衍生本
# ============================================================
sg:LiteraryWork  a  owl:Class ;
  rdfs:subClassOf sg:Thing ;
  rdfs:label "文學作品（版本實體）" .

sg:AncientEdition  a  owl:Class ;
  rdfs:subClassOf sg:LiteraryWork ;
  rdfs:label "古本系統（明刊及更早刻本）" ;
  rdfs:comment "演義系：嘉靖壬午本、周曰校本、葉逢春本、余象斗本、黃正甫本、劉龍田本、朱鼎臣本等；志傳系刻本。" .

sg:AnnotatedEdition  a  owl:Class ;
  rdfs:subClassOf sg:LiteraryWork ;
  rdfs:label "評點改造本（帶評點/改寫的刻本）" ;
  rdfs:comment "李卓吾評本、鍾伯敬評本、李笠翁評本、毛宗崗評本等。" .

sg:ModernCollation  a  owl:Class ;
  rdfs:subClassOf sg:LiteraryWork ;
  rdfs:label "現代整理本（校點/校注/校理本）" ;
  rdfs:comment "人民文學出版社校訂本（顧學頡 1953/1973）、沈伯俊校理本、金聖歎刪改本等。" .

sg:SequelWork  a  owl:Class ;
  rdfs:subClassOf sg:LiteraryWork ;
  rdfs:label "續書衍生本" ;
  rdfs:comment "《續三國演義》（酉陽野史）、《後三國演義》、《反三國演義》（周大荒）等。" .

# 文學作品通用數據屬性（version_id 為主鍵）
sg:versionId       a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain sg:LiteraryWork ; rdfs:range xsd:string ;
  rdfs:label "版本 ID（全局唯一主鍵，sg_version_xxx）" .
sg:versionName     a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain sg:LiteraryWork ; rdfs:range xsd:string ;
  rdfs:label "版本名" .
sg:editionYear     a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain sg:LiteraryWork ; rdfs:range xsd:gYear ;
  rdfs:label "刊刻/出版年代" .
sg:publisher       a owl:DatatypeProperty ;
  rdfs:domain sg:LiteraryWork ; rdfs:range xsd:string ;
  rdfs:label "刊刻/出版機構" .
sg:survivalStatus  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain sg:LiteraryWork ; rdfs:range xsd:string ;
  rdfs:label "存世狀態（全本/殘本/佚失/影印）" .
sg:sourceText      a owl:DatatypeProperty ;
  rdfs:domain sg:LiteraryWork ; rdfs:range xsd:anyURI ;
  rdfs:label "底本來源 URL" .
sg:chapterCount    a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain sg:LiteraryWork ; rdfs:range xsd:integer ;
  rdfs:label "回目總數" .
sg:variantFeature  a owl:DatatypeProperty ;
  rdfs:domain sg:LiteraryWork ; rdfs:range xsd:string ;
  rdfs:label "文本異文特徵（版本特點簡述）" .
sg:familyLineage   a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain sg:LiteraryWork ; rdfs:range xsd:string ;
  rdfs:label "版本族系（yanyi 演義系 / zhizhuan 志傳系 / modern 現代 / sequel 續書）" .
sg:hasFulltext     a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain sg:LiteraryWork ; rdfs:range xsd:boolean ;
  rdfs:label "本站是否已收錄全文" .

# 版本結構子類（對應 jtw 範式：Volume / Chapter / Paragraph）
sg:Volume    a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "卷" .
sg:Chapter   a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "回目" .
sg:Paragraph a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "段落（原文最小文本單元）" .
sg:VariantReading a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "異文讀法（跨版本對勘單位）" .
sg:Commentary    a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "評點文字（夾批/眉批/回前回後批）" .

sg:volumeNo    a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Volume   ; rdfs:range xsd:integer ; rdfs:label "卷序" .
sg:chapterNo   a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Chapter  ; rdfs:range xsd:integer ; rdfs:label "回次" .
sg:chapterTitle a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Chapter ; rdfs:range xsd:string  ; rdfs:label "回目聯語" .
sg:paraNo      a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Paragraph ; rdfs:range xsd:integer ; rdfs:label "段序" .
sg:paragraphText a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Paragraph ; rdfs:range xsd:string ; rdfs:label "段落原文" .

# VariantReading 數據屬性（按版本存讀法）
sg:variantChapter a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:VariantReading ; rdfs:range xsd:integer ; rdfs:label "所處回次" .
sg:variantSection a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:VariantReading ; rdfs:range xsd:string ; rdfs:label "所處段落/情節" .
sg:variantType    a owl:ObjectProperty ; rdfs:domain sg:VariantReading ; rdfs:range sg:variant_type ; rdfs:label "異文類型" .
sg:variantNote    a owl:DatatypeProperty ; rdfs:domain sg:VariantReading ; rdfs:range xsd:string ; rdfs:label "異文說明（考證意義）" .
sg:variantReading_jiajing      a owl:DatatypeProperty ; rdfs:domain sg:VariantReading ; rdfs:range xsd:string ; rdfs:label "嘉靖壬午本讀法" .
sg:variantReading_maozonggang  a owl:DatatypeProperty ; rdfs:domain sg:VariantReading ; rdfs:range xsd:string ; rdfs:label "毛宗崗本讀法" .
sg:variantReading_yefengchun   a owl:DatatypeProperty ; rdfs:domain sg:VariantReading ; rdfs:range xsd:string ; rdfs:label "葉逢春本讀法" .
sg:variantReading_huangzhengfu a owl:DatatypeProperty ; rdfs:domain sg:VariantReading ; rdfs:range xsd:string ; rdfs:label "黃正甫本讀法" .
sg:variantReading_lizhuowu     a owl:DatatypeProperty ; rdfs:domain sg:VariantReading ; rdfs:range xsd:string ; rdfs:label "李卓吾評本讀法" .
sg:variantReading_zhouyuexiao  a owl:DatatypeProperty ; rdfs:domain sg:VariantReading ; rdfs:range xsd:string ; rdfs:label "周曰校本讀法" .

# ============================================================
# 二、人物類（sg:Person）· person_id 主鍵
#    子類：核心文臣 / 武將 / 皇族 / 民間角色 / 少數民族人物
# ============================================================
sg:Person  a  owl:Class ;
  rdfs:subClassOf sg:Thing ;
  rdfs:label "人物" .

sg:CivilOfficial  a owl:Class ; rdfs:subClassOf sg:Person ; rdfs:label "核心文臣（謀士/宰輔/幕僚）" .
sg:General        a owl:Class ; rdfs:subClassOf sg:Person ; rdfs:label "武將" .
sg:Royalty        a owl:Class ; rdfs:subClassOf sg:Person ; rdfs:label "皇族（帝王/后妃/宗室）" .
sg:Commoner       a owl:Class ; rdfs:subClassOf sg:Person ; rdfs:label "民間角色（隱士/醫者/匠人/平民）" .
sg:MinorityFigure a owl:Class ; rdfs:subClassOf sg:Person ; rdfs:label "少數民族人物（匈奴/鮮卑/南蠻/羌/山越）" .
sg:Woman          a owl:Class ; rdfs:subClassOf sg:Person ; rdfs:label "女性角色" .
sg:FictionalFigure a owl:Class ; rdfs:subClassOf sg:Person ; rdfs:label "虛構人物（正史無載）" .

# 人物數據屬性
sg:personId       a owl:DatatypeProperty, owl:FunctionalProperty, owl:InverseFunctionalProperty ;
  rdfs:domain sg:Person ; rdfs:range xsd:string ;
  rdfs:label "人物 ID（sg_person_xxx，與水滸 sh_person_xxx 同構）" .
sg:name           a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain sg:Person ; rdfs:range xsd:string ;
  rdfs:label "姓名" .
sg:zi             a owl:DatatypeProperty ;
  rdfs:domain sg:Person ; rdfs:range xsd:string ;
  rdfs:label "字" .
sg:hao            a owl:DatatypeProperty ;
  rdfs:domain sg:Person ; rdfs:range xsd:string ;
  rdfs:label "號" .
sg:nickname       a owl:DatatypeProperty ;
  rdfs:domain sg:Person ; rdfs:range xsd:string ;
  rdfs:label "綽號/別稱（如『臥龍』『鳳雛』『虎癡』）" .
sg:aliasSet       a owl:DatatypeProperty ;
  rdfs:domain sg:Person ; rdfs:range xsd:string ;
  rdfs:label "別名集合（實體歸一化用）" .
sg:firstChapter   a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain sg:Person ; rdfs:range xsd:integer ;
  rdfs:label "初登場回目" .
sg:deathChapter   a owl:DatatypeProperty ;
  rdfs:domain sg:Person ; rdfs:range xsd:integer ;
  rdfs:label "死亡回目" .
sg:officialHistory a owl:DatatypeProperty ;
  rdfs:domain sg:Person ; rdfs:range xsd:string ;
  rdfs:label "官職變遷序列（JSON 數組）" .
sg:weapon         a owl:DatatypeProperty ;
  rdfs:domain sg:Person ; rdfs:range xsd:string ;
  rdfs:label "兵器" .
sg:ending         a owl:DatatypeProperty ;
  rdfs:domain sg:Person ; rdfs:range xsd:string ;
  rdfs:label "結局" .
sg:fictionalFlag  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain sg:Person ; rdfs:range xsd:boolean ;
  rdfs:label "正史/虛構標註（false=《三國志》有載；true=純虛構）" .
sg:birthYear      a owl:DatatypeProperty ; rdfs:domain sg:Person ; rdfs:range xsd:gYear ; rdfs:label "生年（公元）" .
sg:deathYear      a owl:DatatypeProperty ; rdfs:domain sg:Person ; rdfs:range xsd:gYear ; rdfs:label "卒年（公元）" .
sg:gender         a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Person ; rdfs:range xsd:string ; rdfs:label "性別（男/女）" .
sg:mentionCount   a owl:DatatypeProperty ; rdfs:domain sg:Person ; rdfs:range xsd:integer ; rdfs:label "全書提及次數" .

# ============================================================
# 三、政治勢力類（sg:Faction）· force_id 主鍵
#    子類：東漢朝廷 / 曹魏 / 蜀漢 / 東吳 / 割據諸侯 / 少數民族政權
# ============================================================
sg:Faction  a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "政治勢力" .

sg:HanCourt       a owl:Class ; rdfs:subClassOf sg:Faction ; rdfs:label "東漢朝廷" .
sg:CaoWei         a owl:Class ; rdfs:subClassOf sg:Faction ; rdfs:label "曹魏" .
sg:ShuHan         a owl:Class ; rdfs:subClassOf sg:Faction ; rdfs:label "蜀漢" .
sg:EasternWu      a owl:Class ; rdfs:subClassOf sg:Faction ; rdfs:label "東吳" .
sg:Warlord        a owl:Class ; rdfs:subClassOf sg:Faction ; rdfs:label "割據諸侯（袁紹/袁術/呂布/劉表/劉璋/馬騰/公孫瓚/張魯等）" .
sg:MinorityPower  a owl:Class ; rdfs:subClassOf sg:Faction ; rdfs:label "少數民族政權（南蠻/羌/匈奴/山越/鮮卑/烏桓）" .

sg:forceId         a owl:DatatypeProperty, owl:FunctionalProperty, owl:InverseFunctionalProperty ;
  rdfs:domain sg:Faction ; rdfs:range xsd:string ; rdfs:label "勢力 ID（sg_force_xxx）" .
sg:factionName     a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Faction ; rdfs:range xsd:string ; rdfs:label "勢力名" .
sg:founder         a owl:DatatypeProperty ; rdfs:domain sg:Faction ; rdfs:range xsd:anyURI ; rdfs:label "建立者（URI → sg:Person）" .
sg:periodStart     a owl:DatatypeProperty ; rdfs:domain sg:Faction ; rdfs:range xsd:gYear ; rdfs:label "建立年份" .
sg:periodEnd       a owl:DatatypeProperty ; rdfs:domain sg:Faction ; rdfs:range xsd:gYear ; rdfs:label "滅亡年份" .
sg:capital         a owl:DatatypeProperty ; rdfs:domain sg:Faction ; rdfs:range xsd:string ; rdfs:label "都城（古地名）" .
sg:coreOfficials   a owl:DatatypeProperty ; rdfs:domain sg:Faction ; rdfs:range xsd:string ; rdfs:label "核心文臣武將列表（JSON）" .
sg:territory       a owl:DatatypeProperty ; rdfs:domain sg:Faction ; rdfs:range xsd:string ; rdfs:label "疆域範圍" .
sg:reignTitle      a owl:DatatypeProperty ; rdfs:domain sg:Faction ; rdfs:range xsd:string ; rdfs:label "年號序列" .

# ============================================================
# 四、戰爭戰役類（sg:Battle）· battle_id 主鍵
#    子類：大型會戰 / 局部戰役 / 伏擊戰 / 水戰 / 奇襲戰
# ============================================================
sg:Battle  a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "戰爭戰役" .

sg:MajorBattle  a owl:Class ; rdfs:subClassOf sg:Battle ; rdfs:label "大型會戰（投入兵力≥10 萬或決定天下走向）" .
sg:LocalBattle  a owl:Class ; rdfs:subClassOf sg:Battle ; rdfs:label "局部戰役" .
sg:Ambush       a owl:Class ; rdfs:subClassOf sg:Battle ; rdfs:label "伏擊戰" .
sg:NavalBattle  a owl:Class ; rdfs:subClassOf sg:Battle ; rdfs:label "水戰" .
sg:Raid         a owl:Class ; rdfs:subClassOf sg:Battle ; rdfs:label "奇襲戰（火攻/劫寨/偷襲）" .
sg:Siege        a owl:Class ; rdfs:subClassOf sg:Battle ; rdfs:label "圍城戰" .

sg:battleId      a owl:DatatypeProperty, owl:FunctionalProperty, owl:InverseFunctionalProperty ;
  rdfs:domain sg:Battle ; rdfs:range xsd:string ; rdfs:label "戰役 ID（sg_battle_xxx）" .
sg:battleName    a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Battle ; rdfs:range xsd:string ; rdfs:label "戰役名" .
sg:battleChapter a owl:DatatypeProperty ; rdfs:domain sg:Battle ; rdfs:range xsd:integer ; rdfs:label "發生回目（可多回）" .
sg:battleYear    a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Battle ; rdfs:range xsd:gYear ; rdfs:label "公元紀年" .
sg:sideA         a owl:DatatypeProperty ; rdfs:domain sg:Battle ; rdfs:range xsd:string ; rdfs:label "交戰甲方" .
sg:sideB         a owl:DatatypeProperty ; rdfs:domain sg:Battle ; rdfs:range xsd:string ; rdfs:label "交戰乙方" .
sg:keyTactic     a owl:DatatypeProperty ; rdfs:domain sg:Battle ; rdfs:range xsd:string ; rdfs:label "關鍵戰術" .
sg:outcome       a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Battle ; rdfs:range xsd:string ; rdfs:label "勝負結果" .
sg:impact        a owl:DatatypeProperty ; rdfs:domain sg:Battle ; rdfs:range xsd:string ; rdfs:label "歷史影響" .
sg:casualties    a owl:DatatypeProperty ; rdfs:domain sg:Battle ; rdfs:range xsd:string ; rdfs:label "兵力損耗" .

# ============================================================
# 五、空間地理類（sg:Place）· location_id 主鍵
#    子類：古地名 / 當代坐標 / 關隘 / 都城 / 戰場遺址
# ============================================================
sg:Place  a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "空間地理" .

sg:AncientPlace  a owl:Class ; rdfs:subClassOf sg:Place ; rdfs:label "古地名（州郡縣邑）" .
sg:ModernSite    a owl:Class ; rdfs:subClassOf sg:Place ; rdfs:label "當代對應地點（含坐標）" .
sg:Pass          a owl:Class ; rdfs:subClassOf sg:Place ; rdfs:label "戰略關隘（虎牢關/潼關/劍閣等）" .
sg:Capital       a owl:Class ; rdfs:subClassOf sg:Place ; rdfs:label "都城" .
sg:Battlefield   a owl:Class ; rdfs:subClassOf sg:Place ; rdfs:label "戰場遺址" .
sg:Mountain      a owl:Class ; rdfs:subClassOf sg:Place ; rdfs:label "山嶽（五丈原/定軍山/祁山等）" .
sg:River         a owl:Class ; rdfs:subClassOf sg:Place ; rdfs:label "江河（長江/黃河/渭水/漢水/長坂坡等）" .

sg:locationId       a owl:DatatypeProperty, owl:FunctionalProperty, owl:InverseFunctionalProperty ;
  rdfs:domain sg:Place ; rdfs:range xsd:string ; rdfs:label "地點 ID（sg_place_xxx）" .
sg:ancientName      a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Place ; rdfs:range xsd:string ; rdfs:label "古地名" .
sg:modernName       a owl:DatatypeProperty ; rdfs:domain sg:Place ; rdfs:range xsd:string ; rdfs:label "今地名" .
sg:prefecture       a owl:DatatypeProperty ; rdfs:domain sg:Place ; rdfs:range xsd:string ; rdfs:label "所屬州郡" .
sg:longitude        a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Place ; rdfs:range xsd:double ; rdfs:label "經度" .
sg:latitude         a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Place ; rdfs:range xsd:double ; rdfs:label "緯度" .
sg:strategicValue   a owl:DatatypeProperty ; rdfs:domain sg:Place ; rdfs:range xsd:string ; rdfs:label "戰略地位" .
sg:relatedBattle    a owl:DatatypeProperty ; rdfs:domain sg:Place ; rdfs:range xsd:anyURI ; rdfs:label "關聯戰役" .
sg:modernRuins      a owl:DatatypeProperty ; rdfs:domain sg:Place ; rdfs:range xsd:string ; rdfs:label "當代遗存狀態" .

# ============================================================
# 六、事件類（sg:Event）· event_id 主鍵
#    子類：個人事件 / 政治事件 / 外交事件 / 典故事件
# ============================================================
sg:Event  a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "事件" .

sg:PersonalEvent  a owl:Class ; rdfs:subClassOf sg:Event ; rdfs:label "個人事件（出仕/隱遁/託孤/遇害）" .
sg:PoliticalEvent a owl:Class ; rdfs:subClassOf sg:Event ; rdfs:label "政治事件（禪讓/廢立/篡逆/冊封）" .
sg:DiplomaticEvent a owl:Class ; rdfs:subClassOf sg:Event ; rdfs:label "外交事件（結盟/議和/質子/出使）" .
sg:AllusionEvent  a owl:Class ; rdfs:subClassOf sg:Event ; rdfs:label "典故事件（三顧/草船借箭/空城計/單刀會等成為典故的情節單元）" .

sg:eventId         a owl:DatatypeProperty, owl:FunctionalProperty, owl:InverseFunctionalProperty ;
  rdfs:domain sg:Event ; rdfs:range xsd:string ; rdfs:label "事件 ID（sg_event_xxx）" .
sg:eventName       a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Event ; rdfs:range xsd:string ; rdfs:label "事件名" .
sg:eventChapter    a owl:DatatypeProperty ; rdfs:domain sg:Event ; rdfs:range xsd:integer ; rdfs:label "發生回目" .
sg:eventYear       a owl:DatatypeProperty ; rdfs:domain sg:Event ; rdfs:range xsd:gYear ; rdfs:label "公元紀年" .
sg:participants    a owl:DatatypeProperty ; rdfs:domain sg:Event ; rdfs:range xsd:string ; rdfs:label "參與人物（JSON 數組）" .
sg:eventLocation   a owl:DatatypeProperty ; rdfs:domain sg:Event ; rdfs:range xsd:anyURI ; rdfs:label "發生地點" .
sg:narrativeWeight a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Event ; rdfs:range xsd:integer ; rdfs:label "情節權重（1-10，10 為主線轉折）" .
sg:fictionalEvent  a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Event ; rdfs:range xsd:boolean ; rdfs:label "正史/虛構標註" .

# ============================================================
# 七、學術主體類（sg:Scholar）· scholar_id 主鍵
#    子類：古代評點家 / 近現代三國學者 / 當代研究機構
# ============================================================
sg:Scholar  a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "學術主體" .

sg:AncientCommentator  a owl:Class ; rdfs:subClassOf sg:Scholar ; rdfs:label "古代評點家（李贄/毛宗崗/金聖歎/李漁/鍾惺等）" .
sg:ModernScholar       a owl:Class ; rdfs:subClassOf sg:Scholar ; rdfs:label "近現代三國學者（胡適/魯迅/鄭振鐸/沈伯俊/譚良嘯等）" .
sg:ResearchInstitute   a owl:Class ; rdfs:subClassOf sg:Scholar ; rdfs:label "當代研究機構（中國《三國演義》學會等）" .

sg:scholarId    a owl:DatatypeProperty, owl:FunctionalProperty, owl:InverseFunctionalProperty ;
  rdfs:domain sg:Scholar ; rdfs:range xsd:string ; rdfs:label "學者 ID（sg_scholar_xxx）" .
sg:scholarName  a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Scholar ; rdfs:range xsd:string ; rdfs:label "姓名" .
sg:birthYear    a owl:DatatypeProperty ; rdfs:domain sg:Scholar ; rdfs:range xsd:gYear ; rdfs:label "生年" .
sg:deathYear    a owl:DatatypeProperty ; rdfs:domain sg:Scholar ; rdfs:range xsd:gYear ; rdfs:label "卒年" .
sg:school       a owl:DatatypeProperty ; rdfs:domain sg:Scholar ; rdfs:range xsd:string ; rdfs:label "所屬流派" .
sg:researchField a owl:DatatypeProperty ; rdfs:domain sg:Scholar ; rdfs:range xsd:string ; rdfs:label "核心研究方向" .
sg:majorWorks   a owl:DatatypeProperty ; rdfs:domain sg:Scholar ; rdfs:range xsd:string ; rdfs:label "代表論著" .

# ============================================================
# 八、學術成果類（sg:AcademicWork）· paper_id 主鍵
#    子類：古代評點本 / 現代研究論著 / 學術論文 / 校理校本
# ============================================================
sg:AcademicWork  a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "學術成果" .

sg:CommentaryEdition a owl:Class ; rdfs:subClassOf sg:AcademicWork ; rdfs:label "古代評點本（毛宗崗評點、李卓吾評點等）" .
sg:ModernMonograph   a owl:Class ; rdfs:subClassOf sg:AcademicWork ; rdfs:label "現代研究論著" .
sg:AcademicPaper     a owl:Class ; rdfs:subClassOf sg:AcademicWork ; rdfs:label "學術論文" .
sg:CollatedEdition   a owl:Class ; rdfs:subClassOf sg:AcademicWork ; rdfs:label "校理校本" .

sg:paperId       a owl:DatatypeProperty, owl:FunctionalProperty, owl:InverseFunctionalProperty ;
  rdfs:domain sg:AcademicWork ; rdfs:range xsd:string ; rdfs:label "成果 ID（sg_paper_xxx）" .
sg:paperTitle    a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:AcademicWork ; rdfs:range xsd:string ; rdfs:label "成果標題" .
sg:pubYear       a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:AcademicWork ; rdfs:range xsd:gYear ; rdfs:label "發表/出版年份" .
sg:coreArgument  a owl:DatatypeProperty ; rdfs:domain sg:AcademicWork ; rdfs:range xsd:string ; rdfs:label "核心觀點" .
sg:citations     a owl:DatatypeProperty ; rdfs:domain sg:AcademicWork ; rdfs:range xsd:string ; rdfs:label "引用文獻" .
sg:researchTopic a owl:DatatypeProperty ; rdfs:domain sg:AcademicWork ; rdfs:range xsd:string ; rdfs:label "所屬研究方向" .
sg:baseEdition   a owl:DatatypeProperty ; rdfs:domain sg:AcademicWork ; rdfs:range xsd:anyURI ; rdfs:label "底本選擇說明" .

# ============================================================
# 九、衍生作品類（sg:Adaptation）· adapt_id 主鍵
#    子類：影視/戲曲/動漫/遊戲/同人
# ============================================================
sg:Adaptation  a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "衍生作品" .

sg:FilmTV        a owl:Class ; rdfs:subClassOf sg:Adaptation ; rdfs:label "影視改編" .
sg:Opera         a owl:Class ; rdfs:subClassOf sg:Adaptation ; rdfs:label "戲曲改編（京劇/川劇/越劇等三國戲）" .
sg:Anime         a owl:Class ; rdfs:subClassOf sg:Adaptation ; rdfs:label "動漫改編" .
sg:Game          a owl:Class ; rdfs:subClassOf sg:Adaptation ; rdfs:label "遊戲改編" .
sg:FanWork       a owl:Class ; rdfs:subClassOf sg:Adaptation ; rdfs:label "同人作品" .

sg:adaptId       a owl:DatatypeProperty, owl:FunctionalProperty, owl:InverseFunctionalProperty ;
  rdfs:domain sg:Adaptation ; rdfs:range xsd:string ; rdfs:label "衍生作品 ID（sg_adapt_xxx）" .
sg:adaptName     a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Adaptation ; rdfs:range xsd:string ; rdfs:label "作品名" .
sg:adaptType     a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Adaptation ; rdfs:range xsd:string ; rdfs:label "改編類型" .
sg:releaseYear   a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Adaptation ; rdfs:range xsd:gYear ; rdfs:label "上映/出版年份" .
sg:coreChange    a owl:DatatypeProperty ; rdfs:domain sg:Adaptation ; rdfs:range xsd:string ; rdfs:label "核心改編特徵" .
sg:creatorTeam   a owl:DatatypeProperty ; rdfs:domain sg:Adaptation ; rdfs:range xsd:string ; rdfs:label "主創團隊" .
sg:doubanScore   a owl:DatatypeProperty ; rdfs:domain sg:Adaptation ; rdfs:range xsd:decimal ; rdfs:label "豆瓣評分" .

# ============================================================
# 十、器物類（sg:Artifact）· artifact_id 主鍵
#    子類：兵器 / 名馬 / 陣法 / 發明創造
# ============================================================
sg:Artifact  a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "器物" .

sg:Weapon    a owl:Class ; rdfs:subClassOf sg:Artifact ; rdfs:label "兵器（青龍偃月刀/丈八蛇矛/方天畫戟/倚天劍/青釭劍等）" .
sg:FamousHorse a owl:Class ; rdfs:subClassOf sg:Artifact ; rdfs:label "名馬（赤兔/的盧/絕影/爪黃飛電）" .
sg:Formation a owl:Class ; rdfs:subClassOf sg:Artifact ; rdfs:label "陣法（八陣圖/連環馬/一字長蛇陣等）" .
sg:Invention a owl:Class ; rdfs:subClassOf sg:Artifact ; rdfs:label "發明創造（木牛流馬/連弩/發石車/霹靂車）" .
sg:SealTalisman a owl:Class ; rdfs:subClassOf sg:Artifact ; rdfs:label "印綬符節（玉璽/漢壽亭侯印/假節鉞）" .

sg:artifactId     a owl:DatatypeProperty, owl:FunctionalProperty, owl:InverseFunctionalProperty ;
  rdfs:domain sg:Artifact ; rdfs:range xsd:string ; rdfs:label "器物 ID（sg_artifact_xxx）" .
sg:artifactName   a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Artifact ; rdfs:range xsd:string ; rdfs:label "器物名" .
sg:owner          a owl:DatatypeProperty ; rdfs:domain sg:Artifact ; rdfs:range xsd:anyURI ; rdfs:label "持有者（URI → sg:Person）" .
sg:artifactChapter a owl:DatatypeProperty ; rdfs:domain sg:Artifact ; rdfs:range xsd:integer ; rdfs:label "登場回目" .
sg:function       a owl:DatatypeProperty ; rdfs:domain sg:Artifact ; rdfs:range xsd:string ; rdfs:label "功能特徵" .
sg:allusion       a owl:DatatypeProperty ; rdfs:domain sg:Artifact ; rdfs:range xsd:string ; rdfs:label "歷史典故" .

# ============================================================
# 十一、附屬枚舉：計謀（sg:Stratagem）/ 讖緯（sg:Prophecy）/ 官職（sg:Office）
#     不在你給的 10 大主類內，但作為三國本體的關鍵枚舉補充，
#     對應 jtw 本體的 Spell/Buddha 等枚舉層。
# ============================================================
sg:Stratagem  a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "計謀" .
sg:stratagemId a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Stratagem ; rdfs:range xsd:string ; rdfs:label "計謀 ID" .
sg:stratagemName a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Stratagem ; rdfs:range xsd:string ; rdfs:label "計謀名（三十六計語境）" .

sg:Prophecy  a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "讖緯/預言/童謠" .
sg:prophecyId   a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Prophecy ; rdfs:range xsd:string ; rdfs:label "讖語 ID" .
sg:prophecyText a owl:DatatypeProperty ; rdfs:domain sg:Prophecy ; rdfs:range xsd:string ; rdfs:label "讖語原文" .
sg:prophecyFulfill a owl:DatatypeProperty ; rdfs:domain sg:Prophecy ; rdfs:range xsd:string ; rdfs:label "應驗事件" .

sg:Office  a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "官職" .
sg:officeTitle a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain sg:Office ; rdfs:range xsd:string ; rdfs:label "官職名" .
sg:officeRank  a owl:DatatypeProperty ; rdfs:domain sg:Office ; rdfs:range xsd:string ; rdfs:label "品級" .

# ============================================================
# 十二、24 種核心關係（對象屬性）—— 按你規範全量定義
#     【通用】= 與水滸本體通用；【專屬】= 三國專屬
#     所有關係附 direction / weight 附加屬性（通過 reification 在 ABox 實現，
#     TBox 用 rdf:Property 定義關係本身，屬性特征按語義標記）
# ============================================================

# --- 人物-人物通用（6）---
sg:swornBrotherOf   a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:domain sg:Person ; rdfs:range sg:Person ;
  rdfs:label "【通用】結拜為兄弟" ;
  rdfs:comment "附加：結義回目、排序權重" .

sg:enemyOf_person   a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:domain sg:Person ; rdfs:range sg:Person ;
  rdfs:label "【通用】敵對（人-人）" ;
  rdfs:comment "附加：首次衝突回目、衝突強度" .

sg:masterOf         a owl:ObjectProperty ;
  rdfs:domain sg:Person ; rdfs:range sg:Person ;
  owl:inverseOf sg:apprenticeOf ;
  rdfs:label "【通用】師徒（師→徒）" ;
  rdfs:comment "附加：授藝內容、登場回目" .
sg:apprenticeOf     a owl:ObjectProperty ;
  rdfs:domain sg:Person ; rdfs:range sg:Person ;
  rdfs:label "【通用】師徒（徒→師，反向）" .

sg:kinOf            a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:domain sg:Person ; rdfs:range sg:Person ;
  rdfs:label "【通用】親屬" ;
  rdfs:comment "附加：親屬關係類型（父子/兄弟/夫妻/叔侄等）、輩分" .

# --- 人物-人物專屬（1）主臣 ---
sg:lordOf           a owl:ObjectProperty ;
  rdfs:domain sg:Person ; rdfs:range sg:Person ;
  owl:inverseOf sg:ministerOf ;
  rdfs:label "【專屬·三國】主臣（君→臣）" ;
  rdfs:comment "附加：從屬時間、信任等級、官職" .
sg:ministerOf       a owl:ObjectProperty ;
  rdfs:domain sg:Person ; rdfs:range sg:Person ;
  rdfs:label "【專屬·三國】主臣（臣→君，反向）" .

# --- 人物-勢力專屬（1）所屬 ---
sg:belongsToForce   a owl:ObjectProperty ;
  rdfs:domain sg:Person ; rdfs:range sg:Faction ;
  rdfs:label "【專屬·三國】所屬（人物→勢力）" ;
  rdfs:comment "附加：入職時間、官職變遷序列" .

# --- 人物-戰役專屬（2）指揮 / 參戰 ---
sg:commands         a owl:ObjectProperty ;
  rdfs:domain sg:Person ; rdfs:range sg:Battle ;
  rdfs:label "【專屬·三國】指揮（人物→戰役）" ;
  rdfs:comment "附加：角色定位、戰術貢獻" .

sg:fightsIn         a owl:ObjectProperty ;
  rdfs:domain sg:Person ; rdfs:range sg:Battle ;
  rdfs:label "【專屬·三國】參戰（人物→戰役）" ;
  rdfs:comment "附加：參戰身份、最終結局" .

# --- 勢力-勢力專屬（2）結盟 / 敵對 ---
sg:alliedWith       a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:domain sg:Faction ; rdfs:range sg:Faction ;
  rdfs:label "【專屬·三國】結盟" ;
  rdfs:comment "附加：起止時間、盟約內容（如孫劉聯盟抗曹）" .

sg:enemyOf_force    a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:domain sg:Faction ; rdfs:range sg:Faction ;
  rdfs:label "【專屬·三國】敵對（勢力-勢力）" ;
  rdfs:comment "附加：戰爭狀態起止時間" .

# --- 戰役-地點專屬（1）發生於 ---
sg:battleAt         a owl:ObjectProperty ;
  rdfs:domain sg:Battle ; rdfs:range sg:Place ;
  rdfs:label "【專屬·三國】發生於（戰役→地點）" ;
  rdfs:comment "附加：戰場範圍、地理坐標" .

# --- 版本-版本通用（1）演化自 ---
sg:derivedFrom      a owl:ObjectProperty, owl:TransitiveProperty ;
  rdfs:domain sg:LiteraryWork ; rdfs:range sg:LiteraryWork ;
  rdfs:label "【通用】演化自（版本→版本）" ;
  rdfs:comment "附加：刊刻時間差、文本承襲度（傳遞屬性：A→B, B→C ⇒ A→C）" .

# --- 版本-版本專屬（1）評點改造 ---
sg:annotatedBy      a owl:ObjectProperty ;
  rdfs:domain sg:LiteraryWork ; rdfs:range sg:Scholar ;
  rdfs:label "【專屬·三國】評點改造" ;
  rdfs:comment "附加：改造幅度、核心情節改動（反向從學者角度見 sg:annotatesVersion）" .

# --- 版本-人物通用（1）登場於 ---
sg:appearsIn        a owl:ObjectProperty ;
  rdfs:domain sg:Person ; rdfs:range sg:LiteraryWork ;
  rdfs:label "【通用】登場於（人物→版本）" ;
  rdfs:comment "附加：人物結局差異、文本異文（多版本隔離）" .

# --- 版本-事件通用（1）收錄於 ---
sg:includedIn       a owl:ObjectProperty ;
  rdfs:domain sg:Event ; rdfs:range sg:LiteraryWork ;
  rdfs:label "【通用】收錄於（事件→版本）" ;
  rdfs:comment "附加：情節刪改特徵、文字異文" .

# --- 學者-成果通用（1）創作 ---
sg:authored         a owl:ObjectProperty ;
  rdfs:domain sg:Scholar ; rdfs:range sg:AcademicWork ;
  rdfs:label "【通用】創作（學者→成果）" ;
  rdfs:comment "附加：發表時間、核心觀點摘要" .

# --- 學者-學者通用（1）學術論戰 ---
sg:debatesWith      a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:domain sg:Scholar ; rdfs:range sg:Scholar ;
  rdfs:label "【通用】學術論戰" ;
  rdfs:comment "附加：論戰主題、發表時間" .

# --- 版本-學者通用（1）研究 ---
sg:studiesEdition   a owl:ObjectProperty ;
  rdfs:domain sg:Scholar ; rdfs:range sg:LiteraryWork ;
  rdfs:label "【通用】研究（學者→版本）" ;
  rdfs:comment "附加：研究成果、核心考證結論" .

# --- 事件-地點通用（1）發生於 ---
sg:eventAt          a owl:ObjectProperty ;
  rdfs:domain sg:Event ; rdfs:range sg:Place ;
  rdfs:label "【通用】發生於（事件→地點）" ;
  rdfs:comment "附加：事件時間、地理坐標" .

# --- 衍生作品-版本通用（1）改編自 ---
sg:adaptedFrom      a owl:ObjectProperty ;
  rdfs:domain sg:Adaptation ; rdfs:range sg:LiteraryWork ;
  rdfs:label "【通用】改編自" ;
  rdfs:comment "附加：改編幅度、核心情節改動" .

# --- 人物-器物專屬（1）持有 ---
sg:possesses        a owl:ObjectProperty ;
  rdfs:domain sg:Person ; rdfs:range sg:Artifact ;
  rdfs:label "【專屬·三國】持有（人物→器物）" ;
  rdfs:comment "附加：持有時間、登場回目" .

# --- 戰役-器物專屬（1）使用 ---
sg:usesArtifact     a owl:ObjectProperty ;
  rdfs:domain sg:Battle ; rdfs:range sg:Artifact ;
  rdfs:label "【專屬·三國】使用（戰役→器物）" ;
  rdfs:comment "附加：使用場景、戰術效果（如赤壁之戰→連環計/火攻船）" .

# --- 人物-事件通用（1）參與 ---
sg:participatesIn   a owl:ObjectProperty ;
  rdfs:domain sg:Person ; rdfs:range sg:Event ;
  rdfs:label "【通用】參與（人物→事件）" ;
  rdfs:comment "附加：角色定位、情節權重" .

# --- 人物-地點通用（1）活動於 ---
sg:activeAt         a owl:ObjectProperty ;
  rdfs:domain sg:Person ; rdfs:range sg:Place ;
  rdfs:label "【通用】活動於（人物→地點）" ;
  rdfs:comment "附加：停留回目、事件關聯" .

# --- 補充關係（用於版本文本結構 & 跨本體）---
sg:hasVolume     a owl:ObjectProperty ; rdfs:domain sg:LiteraryWork ; rdfs:range sg:Volume     ; rdfs:label "含卷" .
sg:hasChapter    a owl:ObjectProperty ; rdfs:domain sg:Volume, sg:LiteraryWork ; rdfs:range sg:Chapter ; rdfs:label "含回" .
sg:hasParagraph  a owl:ObjectProperty ; rdfs:domain sg:Chapter ; rdfs:range sg:Paragraph ; rdfs:label "含段" .
sg:mentions      a owl:ObjectProperty ; rdfs:domain sg:Paragraph ; rdfs:range sg:Thing ; rdfs:label "提及（段→實體）" .
sg:correspondsTo a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:domain sg:Chapter ; rdfs:range sg:Chapter ; rdfs:label "跨版本對應回目" .
sg:variantOf     a owl:ObjectProperty ; rdfs:domain sg:VariantReading ; rdfs:range sg:Paragraph ; rdfs:label "異文所屬段落" .
sg:annotates     a owl:ObjectProperty ; rdfs:domain sg:Commentary ; rdfs:range sg:Paragraph ; rdfs:label "評點所註段落" .

# ============================================================
# 十三、OWL 公理：類不相交（DisjointClasses）—— 推理可查實例衝突
# ============================================================
[ a owl:AllDisjointClasses ;
  owl:members ( sg:Person sg:Faction sg:Battle sg:Place sg:Event
                sg:Scholar sg:AcademicWork sg:Adaptation sg:Artifact
                sg:LiteraryWork ) ] .

[ a owl:AllDisjointClasses ;
  owl:members ( sg:AncientEdition sg:AnnotatedEdition sg:ModernCollation sg:SequelWork ) ] .

[ a owl:AllDisjointClasses ;
  owl:members ( sg:CivilOfficial sg:General sg:Royalty sg:Commoner sg:MinorityFigure sg:Woman sg:FictionalFigure ) ] .

[ a owl:AllDisjointClasses ;
  owl:members ( sg:MajorBattle sg:LocalBattle sg:Ambush sg:NavalBattle sg:Raid sg:Siege ) ] .

[ a owl:AllDisjointClasses ;
  owl:members ( sg:Weapon sg:FamousHorse sg:Formation sg:Invention sg:SealTalisman ) ] .

# ============================================================
# 十四、屬性特征：反函數/傳遞/函數/不相交（已在屬性處 inline 聲明）
#     額外：數據類型約束（rdfs:range）已逐個標註。
# ============================================================

# ============================================================
# 十五、受控詞表枚舉（通過 owl:NamedIndividual + skos:Concept）
#    供 ABox 校驗時枚舉取值用
# ============================================================
sg:verification_status  a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "核實狀態" .
sg:vs_verified    a sg:verification_status ; skos:prefLabel "已核實" .
sg:vs_doubtful    a sg:verification_status ; skos:prefLabel "存疑" .
sg:vs_pending     a sg:verification_status ; skos:prefLabel "待核實" .
sg:vs_conflict    a sg:verification_status ; skos:prefLabel "版本間衝突" .

sg:variant_type  a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "異文類型" .
sg:vt_typo       a sg:variant_type ; skos:prefLabel "訛字" .
sg:vt_missing    a sg:variant_type ; skos:prefLabel "脫文" .
sg:vt_extra      a sg:variant_type ; skos:prefLabel "衍文" .
sg:vt_rewrite    a sg:variant_type ; skos:prefLabel "改寫" .
sg:vt_poetry     a sg:variant_type ; skos:prefLabel "詩文增刪" .
sg:vt_plot       a sg:variant_type ; skos:prefLabel "情節增刪" .
sg:vt_commentary a sg:variant_type ; skos:prefLabel "評點增刪" .

sg:relation_weight a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "關係權重" .
sg:rw_core      a sg:relation_weight ; skos:prefLabel "核心（主線）" .
sg:rw_major     a sg:relation_weight ; skos:prefLabel "重要" .
sg:rw_minor     a sg:relation_weight ; skos:prefLabel "次要" .

# ============================================================

# ============================================================
# 十六、正史文獻層（文史互證）
#   對應三國本體的「史/虛」分野能力：
#   RecordsOfThreeKingdoms 陳壽《三國志》（正史）
#   PeiAnnotation          裴松之注（引諸家雜史）
#   OfficialHistoryEvent   正史有載事件
#   SemiFictionalEvent     正史有載但小說加工
#   PureFictionalEvent     純虛構事件（如桃園結義、草船借箭）
# fictionalFlag 0=正史有載 1=正史有載但已加工 2=純虛構
# ============================================================
sg:HistoricalSource  a owl:Class ; rdfs:subClassOf sg:Thing ; rdfs:label "正史文獻" .
sg:RecordsOfThreeKingdoms a owl:Class ; rdfs:subClassOf sg:HistoricalSource ; rdfs:label "陳壽《三國志》（西晉·正史）" .
sg:PeiAnnotation         a owl:Class ; rdfs:subClassOf sg:HistoricalSource ; rdfs:label "裴松之注（南朝宋）" .
sg:HouHanShu              a owl:Class ; rdfs:subClassOf sg:HistoricalSource ; rdfs:label "范曄《後漢書》" .
sg:ZizhiTongjian          a owl:Class ; rdfs:subClassOf sg:HistoricalSource ; rdfs:label "司馬光《資治通鑑》" .

# 事件虛實三級
sg:fictionalFlag  a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:domain sg:Person, sg:Event, sg:Battle, sg:Artifact ;
  rdfs:range xsd:integer ;
  rdfs:label "虛實標註（0=正史有載 1=正史有載小說加工 2=純虛構）" .

# 史源對照
sg:attestedIn   a owl:ObjectProperty ;
  rdfs:domain sg:Person, sg:Event, sg:Battle ; rdfs:range sg:HistoricalSource ;
  rdfs:label "正史載於（文史互證）" .
sg:contradicts  a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:domain sg:Event ; rdfs:range sg:HistoricalSource ;
  rdfs:label "與正史矛盾（小說虛構）" .
sg:embellishedFrom a owl:ObjectProperty ;
  rdfs:domain sg:Event ; rdfs:range sg:HistoricalSource ;
  rdfs:label "從正史片段加工而來（半虛構）" .

