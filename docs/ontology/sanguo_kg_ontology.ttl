sg:sg_var_001  a  sg:VariantReading ;
    sg:variantReading_maozonggang  "為首閃出一將，身長七尺，細眼長髯。" ;
    sg:variantReading_jiajing      "為首閃出一個好英雄，身長七尺，細眼長髯，胆量過人，機謀出眾，乃漢相曹參二十四代孫。" ;
    sg:variantChapter  1 ;
    sg:variantSection  "開篇·曹操出場" ;
    sg:variantType     sg:vt_rewrite ;
    sg:variantNote     "毛本刪去『好英雄』『膽量過人機謀出眾』『曹參二十四代孫』等褒揚曹操的文字，貶曹傾向明顯。" ;
    rdfs:label         "異文 #001：開篇·曹操出場" .

