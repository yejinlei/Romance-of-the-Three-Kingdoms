# ---------- Commentary（评点传承） ----------

sg:commentary_maopi a :Commentary ;
    rdfs:label "毛宗岗评（毛评）"@zh ;
    :commentaryAuthor "毛纶、毛宗岗"@zh ;
    :commentaryPeriod "1679" ;
    :attachedToEdition sg:edition_zhongbojing ;
    skos:note """全面评改，回前总评、夹批、眉批齐备，确立『拥刘反曹』正统观；成为三百年来通行本。"""@zh .

sg:commentary_lizhuo a :Commentary ;
    rdfs:label "李贽评（叶昼伪托）"@zh ;
    :commentaryAuthor "叶昼（托名李贽）"@zh ;
    :commentaryPeriod "~1607" ;
    :attachedToEdition sg:edition_lizhuowu ;
    skos:note """开评点本之风，评语多以『李卓吾曰』『秃翁曰』开头；实为吴人叶昼伪托。"""@zh .

sg:commentary_zhong a :Commentary ;
    rdfs:label "钟伯敬评"@zh ;
    :commentaryAuthor "钟惺"@zh ;
    :commentaryPeriod "~1627" ;
    :attachedToEdition sg:edition_zhongbojing ;
    skos:note """继李评而起，评语较李评简净；开『多家汇评』之渐。"""@zh .

sg:commentary_liyu a :Commentary ;
    rdfs:label "李渔评"@zh ;
    :commentaryAuthor "李渔"@zh ;
    :commentaryPeriod "~1670" ;
    :attachedToEdition sg:edition_liyu ;
    skos:note """戏曲家李渔评小说，重结构文法、宾白节奏；与毛评同时。"""@zh .

sg:commentary_huiping a :Commentary ;
    rdfs:label "汇评本（四家合评）"@zh ;
    :commentaryAuthor "毛宗岗/李贽/李渔/钟惺合刊"@zh ;
    :commentaryPeriod "民国后汇编" ;
    :attachedToEdition sg:edition_maozonggang ;
    skos:note """民国以来合刊四家评语之本，即祁达方所整理『汇评本』所出。"""@zh .

