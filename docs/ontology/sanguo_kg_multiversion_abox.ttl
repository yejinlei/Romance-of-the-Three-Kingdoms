    :majorWork """《三国演义新校注本》·《校理本三国演义》·《三国演义大辞典》"""@zh .

sg:scholar_nicai a :Person, :Scholar ;
    rdfs:label "聂绀弩"@zh ;
    :birthYear "1903"^^xsd:gYear ;
    :deathYear "1986"^^xsd:gYear ;
    :researchField "古典小说评论"@zh ;
    :majorWork """《中国古典小说论集》·论毛本改篡罗贯中"""@zh .

sg:scholar_chenxianghua a :Person, :Scholar ;
    rdfs:label "陈翔华"@zh ;
    :researchField "版本研究"@zh ;
    :majorWork """《三国志通俗演义》成书年代考"""@zh .

# ---------- VariantReading（异文实例） ----------

sg:sg_var_001 a :VariantReading, :StylisticRewrite ;
    rdfs:label "開篇·曹操出場"@zh ;
    :inMaoChapter "1"^^xsd:integer ;
    :maobenText """為首閃出一將，身長七尺，細眼長髯。"""@zh ;
    :jiajingbenText """為首閃出一個好英雄，身長七尺，細眼長髯，胆量過人，機謀出眾，乃漢相曹參二十四代孫。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """毛本刪去『好英雄』『膽量過人機謀出眾』『曹參二十四代孫』等褒揚曹操的文字，貶曹傾向明顯。"""@zh .

sg:sg_var_002 a :VariantReading, :StylisticRewrite ;
    rdfs:label "曹操殺呂伯奢"@zh ;
    :inMaoChapter "4"^^xsd:integer ;
    :maobenText """寧教我負天下人，休教天下人負我！"""@zh ;
    :jiajingbenText """寧使我負天下人，休教天下人負我！"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """『教』vs『使』一字之差，毛本『教』字口氣更強硬、理直氣壯；嘉靖本『使』字帶被動無奈口吻，更符合陳宮評『設心狠毒』的複雜性。此句不見於《三國志》正文，最早見裴注引孫盛《雜記》。"""@zh .

sg:sg_var_003 a :VariantReading, :PoetryVariant ;
    rdfs:label "卷首詞"@zh ;
    :inMaoChapter "1"^^xsd:integer ;
    :maobenText """滾滾長江東逝水，浪花淘盡英雄。是非成敗轉頭空。青山依舊在，幾度夕陽紅。（楊慎《臨江仙》）"""@zh ;
    :jiajingbenText """（無開篇詞，直接以『後漢桓帝崩，靈帝即位』入正文）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """《臨江仙》為明代楊慎所作，毛宗崗託於卷首，嘉靖本無；後世讀者誤以為此即三國開篇。"""@zh .

sg:sg_var_004 a :VariantReading, :PoetryVariant ;
    rdfs:label "桃園結義"@zh ;
    :inMaoChapter "1"^^xsd:integer ;
    :maobenText """念劉備、關羽、張飛雖然異姓，既結為兄弟，則同心協力，救困扶危；上報國家，下安黎庶……"""@zh ;
    :jiajingbenText """三人焚香再拜而說誓曰：『念劉備、關羽、張飛雖然異姓，結為兄弟，則同心協力，救困扶危；上報國家，下安黎庶……』不求同年同月同日生，只願同年同月同日死。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """『不求同年同月同日生，只願同年同月同日死』為毛本（含部分評本）加入，嘉靖本誓詞無此句，屬後世評點家潤色。桃園結義本身正史無載，為民間傳說整合。"""@zh .

sg:sg_var_005 a :VariantReading, :StylisticRewrite ;
    rdfs:label "溫酒斬華雄"@zh ;
    :inMaoChapter "5"^^xsd:integer ;
    :maobenText """（關羽出帳斬華雄，回帳時其酒尚溫）"""@zh ;
    :jiajingbenText """（關羽出帳斬華雄，『其酒尚溫』四字位置、前文對華雄武勇渲染較毛本更詳）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """斬華雄在正史為孫堅所為（《三國志·孫堅傳》），小說移植於關羽，本身為虛構；毛本刪削前文誇飾，節奏更緊。"""@zh .

sg:sg_var_006 a :VariantReading, :StylisticRewrite ;
    rdfs:label "屯土山關公約三事"@zh ;
    :inMaoChapter "25"^^xsd:integer ;
    :maobenText """關公曰：『一者，吾與皇叔設誓，共扶漢室，吾今只降漢帝，不降曹操；二者，二嫂處請給皇叔俸祿養贍，一應上下人等，皆不許到門；三者，但知皇叔去向，不管千里萬里，便當辭去。』"""@zh ;
    :jiajingbenText """關公曰：『一者，吾降漢不降曹；二者，二嫂處請給皇叔俸祿；三者，但知皇叔去向，不管千里萬里，便當辭去。』"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """毛本潤色文字更對仗工整；『降漢不降曹』之核心說法不見正史，為小說家言。"""@zh .

sg:sg_var_007 a :VariantReading, :StylisticRewrite ;
    rdfs:label "趙子龍長阪坡"@zh ;
    :inMaoChapter "41"^^xsd:integer ;
    :maobenText """趙雲懷抱後主，直透重圍，砍倒大旗兩面，奪槊三條；前後槍刺劍砍，殺死曹營名將五十餘員。"""@zh ;
    :jiajingbenText """趙雲懷抱阿斗，直透重圍，砍倒大旗兩面，奪槊三條；前後槍刺劍砍，殺死曹營名將五十餘員。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """『後主』vs『阿斗』：毛本改稱號，嘉靖本用小字；毛本對趙雲形象的神化程度更高，加後文『曹操下令不許放冷箭』以成全趙雲之勇。"""@zh .

sg:sg_var_008 a :VariantReading, :PlotVariant ;
    rdfs:label "草船借箭"@zh ;
    :inMaoChapter "46"^^xsd:integer ;
    :maobenText """（諸葛亮以草船二十隻借箭十餘萬）"""@zh ;
    :jiajingbenText """（情節基本相同，但借箭數『十餘萬』寫法與毛本略異；且孫權濡須之戰『借箭』原型在《魏略》，主角本為孫權）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """草船借箭原型為孫權（裴注引《魏略》），《三國志平話》移植於周瑜，小說最終定型為諸葛亮，是「狀諸葛之多智而近妖」的典型段落。"""@zh .

sg:sg_var_009 a :VariantReading, :StylisticRewrite ;
    rdfs:label "諸葛祭風"@zh ;
    :inMaoChapter "49"^^xsd:integer ;
    :maobenText """七星壇上諸葛亮祭東南風。"""@zh ;
    :jiajingbenText """七星壇諸葛祭風，情節文字略樸，毛本加強儀式細節與神異描寫。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """祭風為純粹小說虛構，正史載赤壁之戰為黃蓋詐降火攻，冬月偶有東南風屬自然現象；毛本進一步神化諸葛亮。"""@zh .

sg:sg_var_010 a :VariantReading, :PlotVariant ;
    rdfs:label "華容道關羽釋曹"@zh ;
    :inMaoChapter "50"^^xsd:integer ;
    :maobenText """關雲長義釋曹操。"""@zh ;
    :jiajingbenText """關雲長義釋曹操（後文有毛宗崗回評大加發揮『義絕』主題，嘉靖本評點較樸）。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """華容道釋曹正史無載（《山陽公載記》有曹操赤壁後從華容道過的記載，但無關羽放行），為小說為塑造關羽『義絕』而設；毛本增強戲劇性。"""@zh .

sg:sg_var_011 a :VariantReading, :PlotVariant ;
    rdfs:label "上方谷火燒魏延（被毛本刪）"@zh ;
    :inMaoChapter "95"^^xsd:integer ;
    :maobenText """（毛本全段刪去，只寫司馬懿父子被困上方谷，天降大雨得脫）"""@zh ;
    :jiajingbenText """孔明令魏延誘司馬懿入葫蘆峪（上方谷），預埋火藥欲一舉燒死司馬懿與魏延；天降大雨，魏延幸免，事後大罵孔明。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本此段對諸葛亮形象有貶損（為除後患不惜暗害己方大將），毛本出於『狀諸葛之智』的正統塑造而全段刪除，是毛本『聖化』諸葛的關鍵手筆。"""@zh .

sg:sg_var_012 a :VariantReading, :StylisticRewrite ;
    rdfs:label "五丈原諸葛病逝"@zh ;
    :inMaoChapter "103"^^xsd:integer ;
    :maobenText """『再不能臨陣討賊矣！悠悠蒼天，曷此其極！』"""@zh ;
    :jiajingbenText """『吾再不能出軍征討逆賊矣！悠悠蒼天，曷此其極！』"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """毛本將『征討逆賊』改『臨陣討賊』，語氣更凝練悲壯，強化『出師未捷身先死』之感。"""@zh .

sg:sg_var_013 a :VariantReading, :OrthographicVariant ;
    rdfs:label "張飛世居涿郡"@zh ;
    :inMaoChapter "1"^^xsd:integer ;
    :maobenText """世居涿郡，頗有莊田，賣酒屠豬，專好結交天下豪傑。"""@zh ;
    :jiajingbenText """世居涿郡，頗有田莊，賣酒屠豬，專好結交天下豪傑。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """『莊田/田莊』倒文，毛本順口。"""@zh .

sg:sg_var_014 a :VariantReading, :StylisticRewrite ;
    rdfs:label "隆中對"@zh ;
    :inMaoChapter "38"^^xsd:integer ;
    :maobenText """將軍既帝室之冑，信義著於四海，總攬英雄，思賢如渴……"""@zh ;
    :jiajingbenText """將軍既帝室之冑，信義著於四海，攬英雄，思賢如渴……"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """毛本加『總』字使文氣更暢；《隆中對》本文見《三國志·諸葛亮傳》，小說文字與正史大體一致但有文學潤色。"""@zh .

sg:sg_var_015 a :VariantReading, :StylisticRewrite ;
    rdfs:label "呂布弑丁原"@zh ;
    :inMaoChapter "3"^^xsd:integer ;
    :maobenText """（呂布受李肅說降，當夜斬丁原首級獻董卓）"""@zh ;
    :jiajingbenText """（情節同，但毛本強化李肅說辭的利誘力度與呂布見利忘義的嘴脸）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """史有丁原被呂布殺事，細節為小說加工；毛本更強三姓家奴的反覆形象。"""@zh .

sg:sg_var_016 a :VariantReading, :PlotVariant ;
    rdfs:label "捉放曹·陳宮"@zh ;
    :inMaoChapter "4"^^xsd:integer ;
    :maobenText """（陳宮捉曹操又釋之，因操殺呂伯奢而離去）"""@zh ;
    :jiajingbenText """（陳宮為中牟縣令，捉放曹後，陳宮因呂伯奢事離去，但嘉靖本陳宮心理描寫較毛本少）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """正史中捉放曹者並非陳宮，《魏書》載為一不知名功曹；陳宮後因叛曹迎呂布被曹操所殺，小說將二事合併為典型的「曹操奸雄」段落。"""@zh .

sg:sg_var_017 a :VariantReading, :OrthographicVariant ;
    rdfs:label "青梅煮酒論英雄"@zh ;
    :inMaoChapter "21"^^xsd:integer ;
    :maobenText """今天下英雄，惟使君與操耳！"""@zh ;
    :jiajingbenText """今天下英雄，惟使君與操耳！"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """此句與《三國志·先主傳》基本一致（「今天下英雄，唯使君與操耳。本初之徒，不足數也」），是小說最接近正史原文的名言之一。"""@zh .

sg:sg_var_018 a :VariantReading, :StylisticRewrite ;
    rdfs:label "小霸王怒斬于吉"@zh ;
    :inMaoChapter "29"^^xsd:integer ;
    :maobenText """（孫策怒斬道士于吉，後于吉數次顯靈，孫策創裂而亡）"""@zh ;
    :jiajingbenText """（情節大體一致，但毛本加強于吉顯靈的神怪描寫，將孫策之死完全歸因於因果報應）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """正史載孫策為許貢客刺殺，創傷而崩；于吉為方士，裴注引《江表傳》有孫策欲殺于吉事，但顯靈索命純屬小說家言。"""@zh .

sg:sg_var_019 a :VariantReading, :StylisticRewrite ;
    rdfs:label "趙子龍截江奪阿斗"@zh ;
    :inMaoChapter "43"^^xsd:integer ;
    :maobenText """趙雲飛身趕上船，奪回阿斗。"""@zh ;
    :jiajingbenText """趙雲跳上船奪回阿斗，文字較毛本樸素。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """截江奪阿斗正史有載（《趙雲別傳》），是少見的與正史高度吻合的趙雲段落。"""@zh .

sg:sg_var_020 a :VariantReading, :PoetryVariant ;
    rdfs:label "曹操大宴銅雀臺"@zh ;
    :inMaoChapter "56"^^xsd:integer ;
    :maobenText """（銅雀臺大宴，曹氏父子賦詩，武將比箭）"""@zh ;
    :jiajingbenText """（毛本增加大量詩文場面，特別是曹植、王粲等人銅雀臺賦內容；嘉靖本較簡）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """銅雀台賦《三國志》有載，但小說中『攬二喬於東南兮』一句為唐杜牧詩與小說附會，諸葛亮智激周瑜實為小說虛構。"""@zh .

sg:sg_var_021 a :VariantReading, :OrthographicVariant ;
    rdfs:label "龐德抬櫬戰關公"@zh ;
    :inMaoChapter "74"^^xsd:integer ;
    :maobenText """龐德抬櫬（棺材）出征，以示決死。"""@zh ;
    :jiajingbenText """龐德舁櫬出征，意義相同但字稍古。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """『抬』『舁』異文，抬為後起字。龐德戰敗被擒不降而死為正史有載。"""@zh .

sg:sg_var_022 a :VariantReading, :PlotVariant ;
    rdfs:label "關公刮骨療毒"@zh ;
    :inMaoChapter "75"^^xsd:integer ;
    :maobenText """（關公刮骨療毒，與馬良飲酒弈棋，談笑自若）"""@zh ;
    :jiajingbenText """（情節同，但醫者非華佗；毛本改為華佗為關公治傷）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """刮骨療毒《三國志·關羽傳》有載，但醫者無名（華佗卒於建安十三年，時關羽中箭在建安二十四年，華佗已死 11 年，不可能為關公治傷）；毛本為神化關公與華佗而張冠李戴。"""@zh .

sg:sg_var_023 a :VariantReading, :OrthographicVariant ;
    rdfs:label "急兄仇張飛遇害"@zh ;
    :inMaoChapter "81"^^xsd:integer ;
    :maobenText """范疆、張達刺張飛。"""@zh ;
    :jiajingbenText """范彊、張達刺張飛。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """『范彊』為正史《三國志》用字，『范疆』為毛本誤字（疆彊形近而訛），沈伯俊校理本已改回『范彊』。"""@zh .

sg:sg_var_024 a :VariantReading, :StylisticRewrite ;
    rdfs:label "陸遜營燒七百里·八陣圖"@zh ;
    :inMaoChapter "84"^^xsd:integer ;
    :maobenText """（陸遜追劉備入漁腹浦，困於諸葛亮所布八陣圖，得黃承彥引出）"""@zh ;
    :jiajingbenText """（八陣圖情節嘉靖本已有，但毛本加強玄學氛圍與黃承彥出場的描寫）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """夷陵之戰火燒連營正史有載，陸遜確實退兵以防魏，但『八陣圖困陸遜』為純粹小說虛構。"""@zh .

sg:sg_var_025 a :VariantReading, :StylisticRewrite ;
    rdfs:label "劉先主遺詔託孤"@zh ;
    :inMaoChapter "85"^^xsd:integer ;
    :maobenText """若嗣子可輔，則輔之；如其不才，君可自取。"""@zh ;
    :jiajingbenText """若嗣子可輔，則輔之；如其不才，君可自取為成都王。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本多『為成都王』四字，語氣近於試探或准許取而代之；毛本刪四字，使『自取』意義更開放（或指自取天下、或指自取帝位），此處是史家與評點家爭論白帝城託孤真意的關鍵異文。此語出自《三國志·諸葛亮傳》原文：『如其不才，君可自取』，嘉靖本衍『為成都王』反為後人加筆。"""@zh .

sg:sg_var_026 a :VariantReading, :PlotVariant ;
    rdfs:label "孔明揮淚斬馬謖"@zh ;
    :inMaoChapter "90"^^xsd:integer ;
    :maobenText """（孔明揮淚斬馬謖，蔣琬勸阻）"""@zh ;
    :jiajingbenText """（情節同，但嘉靖本有馬謖下獄後寫信給孔明一段，毛本改為當場斬首）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """據《三國志》馬謖下獄後物故（死於獄中），非當場斬首；小說為加強戲劇性與『軍令狀』悲劇改為當場處斬。"""@zh .

sg:sg_var_027 a :VariantReading, :PoetryVariant ;
    rdfs:label "隕大星漢丞相歸天"@zh ;
    :inMaoChapter "104"^^xsd:integer ;
    :maobenText """（是夜天愁地慘，月色無光，孔明奄然歸天；天象有赤星自東北流于西南，投入亮營，三投再還）"""@zh ;
    :jiajingbenText """（流星描寫嘉靖本較簡，毛本加大段『天愁地慘』的氛圍渲染與讚詩）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """『赤星墜營』出自裴注引《晉陽秋》：『有星赤而芒角，自東北西南流，投於亮營，三投再還，往大還小。俄而亮卒』；毛本多加大量後人吊詩。"""@zh .

sg:sg_var_028 a :VariantReading, :StylisticRewrite ;
    rdfs:label "假投降巧計成虛話"@zh ;
    :inMaoChapter "119"^^xsd:integer ;
    :maobenText """姜維假降鍾會，謀反魏復蜀，事敗被殺，姜維維膽大如斗。"""@zh ;
    :jiajingbenText """姜維假降鍾會，事敗死，文字較樸，『膽大如斗』之細節毛本渲染更詳。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """姜維假降鍾會謀反事見《三國志》及裴注引《漢晉春秋》，大體為真；『膽大如斗』出自《華陽國志》。"""@zh .

sg:sg_var_029 a :VariantReading, :OrthographicVariant ;
    rdfs:label "推士品孔明夫人（黃氏無醜名）"@zh ;
    :inMaoChapter "120"^^xsd:integer ;
    :maobenText """（毛本無黃氏容貌描寫，但坊間本多流傳『黃頭黑色』醜女形象，此說來自《襄陽記》）"""@zh ;
    :jiajingbenText """（嘉靖本同毛本不描容貌）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """黃月英之名最早出自晚近小說/京劇，《三國志》及明本均無『黃月英』名與容貌細節；此為版本演變與後世改動的例子。"""@zh .

sg:sg_var_030 a :VariantReading, :PoetryVariant ;
    rdfs:label "三分局勢歸一統"@zh ;
    :inMaoChapter "120"^^xsd:integer ;
    :maobenText """自此三國歸于晉帝司馬炎，為太康元年，所謂『天下大勢，合久必分，分久必合』。"""@zh ;
    :jiajingbenText """自此三國歸於晉，『蒼天已死，黃天當立』之讖終應，歎息久矣。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """『天下大勢，合久必分，分久必合』開篇明言，結尾呼應；此句為毛宗崗自鑄偉辭，嘉靖本結段議論不同，著重歷史滄桑感而非循環史觀總結。"""@zh .

sg:sg_var_031 a :VariantReading, :PlotVariant ;
    rdfs:label "張郃戰張飛·宕渠之戰回合數"@zh ;
    :inMaoChapter "戰績"^^xsd:integer ;
    :maobenText """兩將在火光中，戰到三五十合。"""@zh ;
    :jiajingbenText """戰到百十余合。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing, sg:edition_yefengchun, sg:edition_huangzhengfu ;
    :scholarlySignificance """同一戰斗，四個版本單挑回合數相差 5 倍（十余合至百十余合）——這是三國武力評論網絡爭議的版本學根源。嘉靖本最長，黃正甫本最短，毛本取中。"""@zh .

sg:sg_var_032 a :VariantReading, :MaobenAddition ;
    rdfs:label "刘备家世·家世谱系"@zh ;
    :inMaoChapter "1"^^xsd:integer ;
    :maobenText """中山靖王刘胜之后，汉景帝阁下玄孙，姓刘名备，字玄德。"""@zh ;
    :jiajingbenText """中山靖王刘胜之后，汉景帝阁下玄孙，姓刘名备，字玄德……尝师事郑玄、卢植，与公孙瓒等为友。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本交代刘备师事郑玄卢植、与公孙瓒为友，毛本删去，使刘备早年交游脉络不明。"""@zh .

sg:sg_var_033 a :VariantReading, :OrthographicVariant ;
    rdfs:label "张飞的字"@zh ;
    :inMaoChapter "1"^^xsd:integer ;
    :maobenText """姓张名飞，字翼德。"""@zh ;
    :jiajingbenText """姓张名飞，字益德。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本作『益德』（与《三国志·张飞传》一致）；毛本改『翼德』以合『羽翼』之意，但不符史。沈伯俊校理本已回改。"""@zh .

sg:sg_var_034 a :VariantReading, :StylisticRewrite ;
    rdfs:label "关羽籍贯"@zh ;
    :inMaoChapter "1"^^xsd:integer ;
    :maobenText """吾姓关名羽，字长生，后改云长，河东解良人也。"""@zh ;
    :jiajingbenText """吾姓关名羽，字长生，后改云长，河东解良人也。因本处豪霸倚势欺人，关某杀之，逃难江湖五六年矣。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本明言关羽杀豪强逃亡，毛本略去，削弱关羽早期『亡命』色彩。"""@zh .

sg:sg_var_035 a :VariantReading, :PlotTransfer ;
    rdfs:label "华雄实斩于谁手"@zh ;
    :inMaoChapter "5"^^xsd:integer ;
    :maobenText """（关羽）出帐提刀，飞身上马……鸾铃响处，马到中军，云长提华雄之头，掷于地上。其酒尚温。"""@zh ;
    :jiajingbenText """（关羽斩华雄文字与毛本同）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """注：史实华雄为孙坚所斩（《三国志·孙破虏传》）；毛本、嘉靖本均归关羽，此为演义共同虚构。"""@zh .

sg:sg_var_036 a :VariantReading, :MaobenAddition ;
    rdfs:label "三英战吕布·张飞骂『三姓家奴』"@zh ;
    :inMaoChapter "5"^^xsd:integer ;
    :maobenText """（张飞）圆睁环眼，倒竖虎须，挺丈八蛇矛，飞马大叫：『三姓家奴休走！燕人张飞在此！』"""@zh ;
    :jiajingbenText """（张飞）挺丈八矛，飞马大叫：『吕布休走！』"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """『三姓家奴』这一著名骂词为毛本新增，嘉靖本仅作『吕布休走』。"""@zh .

sg:sg_var_037 a :VariantReading, :MaobenAddition ;
    rdfs:label "貂蝉身世交代"@zh ;
    :inMaoChapter "8"^^xsd:integer ;
    :maobenText """其女自幼选入府中，教以歌舞，年方二八，色伎俱佳，允以亲女待之。"""@zh ;
    :jiajingbenText """其女自幼选入府中，教以歌舞吹弹，年方二十八，色伎俱佳，允以亲女待之。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本貂蝉年龄为『年方二十八』，毛本改作『年方二八』（十六岁）。按年龄当为嘉靖本更可信（王允掌府多年），毛本改弱龄以增美人计戏剧性。"""@zh .

sg:sg_var_038 a :VariantReading, :StylisticRewrite ;
    rdfs:label "董承密诏·马腾入盟名单"@zh ;
    :inMaoChapter "20"^^xsd:integer ;
    :maobenText """（董承）遂取袍带，拆开视之，乃密诏也……承乃与王子服、吴子兰、种辑、吴硕、马腾、刘备等共议。"""@zh ;
    :jiajingbenText """承观毕……乃与工部侍郎王子服、长水校尉种辑、议郎吴硕、昭信将军吴子兰、西凉太守马腾、左将军刘备等歃血为盟。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本各人官职齐备，毛本简化。"""@zh .

sg:sg_var_039 a :VariantReading, :StylisticRewrite ;
    rdfs:label "煮酒论英雄·曹操论龙文字"@zh ;
    :inMaoChapter "21"^^xsd:integer ;
    :maobenText """龙能大能小，能升能隐；大则兴云吐雾，小则隐介藏形……"""@zh ;
    :jiajingbenText """龙者，能大能小，能升能隐；大则吐雾兴云，小则埋头伏爪藏牙……方今春深，龙乘时变化，犹人得志而纵横四海也。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本多『埋头伏爪藏牙』『方今春深……犹人得志而纵横四海也』，文采更胜毛本；毛本删去使行文紧促。"""@zh .

sg:sg_var_040 a :VariantReading, :PlotVariant ;
    rdfs:label "屯土山·张辽说三罪"@zh ;
    :inMaoChapter "25"^^xsd:integer ;
    :maobenText """辽曰：『……今玄德不知存亡，翼德未知生死……兄若战死，有三罪……』"""@zh ;
    :jiajingbenText """辽曰：『……兄若降之，一者可以保二夫人，二者不背桃园之约，三者可留有用之身……』"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本张辽说三便（保二夫人/守桃园约/留有用身），毛本改作『三罪』（负兄/负嫂/负约），重心从『利』转『义』。"""@zh .

sg:sg_var_041 a :VariantReading, :StylisticRewrite ;
    rdfs:label "关羽三事之次序"@zh ;
    :inMaoChapter "25"^^xsd:integer ;
    :maobenText """一者，吾与皇叔设誓共扶汉室，吾今只降汉帝，不降曹操；二者……但知皇叔去向便辞；三者……"""@zh ;
    :jiajingbenText """一者，吾与刘皇叔同誓共扶汉室，吾今只降汉帝，不降曹操；二者，二嫂处请给皇叔俸禄养赡；三者，但知皇叔去向，不管千里万里，便当辞去。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本第二事为『二嫂俸禄』，毛本将第二第三互换，把『寻兄』提到第二以强化关羽不忘刘备。"""@zh .

sg:sg_var_042 a :VariantReading, :MaobenAddition ;
    rdfs:label "赤兔马·曹操赠马"@zh ;
    :inMaoChapter "25"^^xsd:integer ;
    :maobenText """操指马曰：『公识此马否？』公曰：『莫非吕布所骑赤兔马乎？……』"""@zh ;
    :jiajingbenText """操令左右备一疋马来……那马身如火炭，状甚雄伟……公曰：『此马日行千里，今幸得之，若知兄长下落，可一日而见面矣。』"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """两本大致相同，但嘉靖本多『可一日而见面矣』之语，关羽得马第一念即寻兄，毛本同。"""@zh .

sg:sg_var_043 a :VariantReading, :PlotVariant ;
    rdfs:label "过五关路线矛盾"@zh ;
    :inMaoChapter "27"^^xsd:integer ;
    :maobenText """东岭关→洛阳→沂水关→荥阳→滑州黄河渡口"""@zh ;
    :jiajingbenText """东岭关→洛阳→沂水关→荥阳→滑州黄河渡口"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """两本路线地理都不通（从许都往河北不应绕行洛阳）；沈伯俊校理本据史地改订。此处为两本共同地理硬伤。"""@zh .

sg:sg_var_044 a :VariantReading, :StylisticRewrite ;
    rdfs:label "古城会·关羽斩蔡阳后张飞态度"@zh ;
    :inMaoChapter "28"^^xsd:integer ;
    :maobenText """（张飞）直到城下，大叫：『哥哥！』关公望见张飞到来……挥刀斩蔡阳……飞乃大哭。"""@zh ;
    :jiajingbenText """飞疑关公降曹，再三质问；关公斩蔡阳后，张飞又问随行二嫂，二嫂备言前事，飞方大哭参拜。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本张飞反复质问、二嫂作证，心理刻画较细；毛本简化。"""@zh .

sg:sg_var_045 a :VariantReading, :StylisticRewrite ;
    rdfs:label "碧眼儿坐领江东·孙权形貌"@zh ;
    :inMaoChapter "29"^^xsd:integer ;
    :maobenText """孙权生得方颐大口，碧眼紫髯。"""@zh ;
    :jiajingbenText """孙权生得方颐大口，碧眼紫髯，形貌奇伟，骨体不恒。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本多『形貌奇伟，骨体不恒』（用《三国志》陈寿评语），毛本略。"""@zh .

sg:sg_var_046 a :VariantReading, :MaobenAddition ;
    rdfs:label "许攸问粮·曹操口误次数"@zh ;
    :inMaoChapter "30"^^xsd:integer ;
    :maobenText """攸曰：『公今军粮尚有几何？』操曰：『可支一年。』攸笑曰：『恐未必。』……后说到『只得一月』『粮尽矣』。"""@zh ;
    :jiajingbenText """（同样五次谎言），但嘉靖本多许攸当众揶揄一句：『世人皆言孟德奸雄，今果然也。』操亦笑曰：『岂不闻兵不厌诈？』"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本多曹操『兵不厌诈』自承之语，毛本删之使曹操奸雄『自辩』更隐。"""@zh .

sg:sg_var_047 a :VariantReading, :PoetryVariant ;
    rdfs:label "三顾·诸葛亮午睡醒后吟诗"@zh ;
    :inMaoChapter "37"^^xsd:integer ;
    :maobenText """（孔明翻身问童子）『有俗客来否？』……口吟诗曰：『大梦谁先觉？平生我自知……』"""@zh ;
    :jiajingbenText """（孔明醒后吟诗同），但毛本补『草堂春睡足，窗外日迟迟』二句，为最著者。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """『草堂春睡足，窗外日迟迟』二句为毛本所增，成三顾经典意象。嘉靖本无此二句。"""@zh .

sg:sg_var_048 a :VariantReading, :StylisticRewrite ;
    rdfs:label "隆中对·诸葛亮『霸业可成』与『汉室可兴』"@zh ;
    :inMaoChapter "38"^^xsd:integer ;
    :maobenText """……则霸业可成，汉室可兴矣。"""@zh ;
    :jiajingbenText """……则大业可成，汉室可兴矣。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本作『大业』，毛本改『霸业』——一词之差，把诸葛亮从『王佐之才』降为『助成霸业者』，被研究者视为毛本暗含讥贬。"""@zh .

sg:sg_var_049 a :VariantReading, :OrthographicVariant ;
    rdfs:label "孔明初用兵·博望坡军师初用兵"@zh ;
    :inMaoChapter "39"^^xsd:integer ;
    :maobenText """博望坡军师初用兵"""@zh ;
    :jiajingbenText """诸葛亮博望烧屯"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本回目直写事件，毛本用『初用兵』强调孔明首战，属于回目文学加工。"""@zh .

sg:sg_var_050 a :VariantReading, :StylisticRewrite ;
    rdfs:label "赵云长坂·救阿斗细节"@zh ;
    :inMaoChapter "41"^^xsd:integer ;
    :maobenText """云乃拔青釭剑乱砍……怀抱后主，直透重围……"""@zh ;
    :jiajingbenText """云拔青釭剑砍之，手起衣甲平过，血如涌泉……推倒土墙埋糜夫人尸首，怀抱后主突围。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本多赵云推墙埋糜夫人、防曹军盗尸的细节，见其缜密；毛本略去。"""@zh .

sg:sg_var_051 a :VariantReading, :StylisticRewrite ;
    rdfs:label "舌战群儒·与虞翻薛综陆绩论辩"@zh ;
    :inMaoChapter "43"^^xsd:integer ;
    :maobenText """（孔明与群儒辩，含虞翻、步骘、薛综、陆绩、严畯、程德枢）"""@zh ;
    :jiajingbenText """（同有群儒，但多出对张温、骆统二人的答辩，毛本删此二人）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本孔明实驳七人，毛本改为五人（删张温骆统），使舌战更紧凑。"""@zh .

sg:sg_var_052 a :VariantReading, :PlotVariant ;
    rdfs:label "草船借箭·孔明借箭对象为孙权还是周瑜"@zh ;
    :inMaoChapter "46"^^xsd:integer ;
    :maobenText """诸葛亮乘大雾向曹营草船借箭，给周瑜交差。"""@zh ;
    :jiajingbenText """情节相同。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """史实『草船借箭』为孙权濡须口事（《魏略》）；两本均移给孔明，属共同虚构。"""@zh .

sg:sg_var_053 a :VariantReading, :PoetryVariant ;
    rdfs:label "横槊赋诗·『月明星稀，乌鹊南飞』"@zh ;
    :inMaoChapter "48"^^xsd:integer ;
    :maobenText """（曹操横槊赋《短歌行》，刘馥进言被刺）"""@zh ;
    :jiajingbenText """（同有横槊赋诗，但嘉靖本多曹操赋毕回顾刘馥时的自辩之语，毛本简化）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """两本皆有赋诗，但嘉靖本曹操骄态更露。"""@zh .

sg:sg_var_054 a :VariantReading, :PlotVariant ;
    rdfs:label "华容道·曹操三笑"@zh ;
    :inMaoChapter "49"^^xsd:integer ;
    :maobenText """操见树木丛杂……遂于马上仰面大笑……一声炮响，赵云杀出……又走……又笑，张飞杀出……又笑，关羽截出……"""@zh ;
    :jiajingbenText """三笑同，但嘉靖本曹操每笑一次都有『吾不笑别人，单笑周瑜无谋、诸葛亮少智』完整句式，毛本简化。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本三笑皆有重复句式作节奏，更见话本本色。"""@zh .

sg:sg_var_055 a :VariantReading, :PoetryVariant ;
    rdfs:label "玄德智激孙夫人·『周郎妙计安天下』"@zh ;
    :inMaoChapter "55"^^xsd:integer ;
    :maobenText """后人有诗曰：『周郎妙计安天下，赔了夫人又折兵！』"""@zh ;
    :jiajingbenText """有诗，但『赔了夫人又折兵』作『陪了夫人又折兵』（陪/赔不同），且诗后还有周瑜『金疮迸裂』细节更详。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """『陪/赔』之异反映版本用字；毛本『赔』更口语化，成后世习语。"""@zh .

sg:sg_var_056 a :VariantReading, :StylisticRewrite ;
    rdfs:label "马孟起兴兵·马超与曹操阵前对话"@zh ;
    :inMaoChapter "58"^^xsd:integer ;
    :maobenText """操出马……马超咬牙切齿，大骂：『操贼！欺君罔上，罪不容诛！』"""@zh ;
    :jiajingbenText """（多出马超一段痛骂：『……吾乃汉伏波将军马援之后，岂与曹贼共戴天！』）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本马超自报门第、衔恨渊源更清楚。"""@zh .

sg:sg_var_057 a :VariantReading, :PlotVariant ;
    rdfs:label "许褚裸衣斗马超·回合数与细节"@zh ;
    :inMaoChapter "59"^^xsd:integer ;
    :maobenText """（许褚裸衣斗马超），许褚臂中两箭，混战一场。"""@zh ;
    :jiajingbenText """嘉靖本两将大战至『褚弃刀挟枪，拗断枪杆，各拿半节乱打』，细节更猛；毛本略有压缩。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本武打细节更富平话风味，毛本整炼。"""@zh .

sg:sg_var_058 a :VariantReading, :StylisticRewrite ;
    rdfs:label "单刀赴会·关羽周仓之对答"@zh ;
    :inMaoChapter "66"^^xsd:integer ;
    :maobenText """云长右手提刀，左手挽住鲁肃手……"""@zh ;
    :jiajingbenText """多周仓在阶下厉声言『夫土地者，惟德所在耳，何常之有』被关公叱退一段，为元杂剧《单刀会》遗留。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本周仓有一段激烈辞令，袭自关汉卿《关大王单刀会》，毛本保留但减弱。"""@zh .

sg:sg_var_059 a :VariantReading, :StylisticRewrite ;
    rdfs:label "曹孟德忌杀杨修·『鸡肋』解"@zh ;
    :inMaoChapter "72"^^xsd:integer ;
    :maobenText """（曹操以『鸡肋』口令杀杨修，列举杨修六件犯忌事：园门『活』字/一合酥/梦中杀人/曹丕吴质/曹操试子/答教十条）"""@zh ;
    :jiajingbenText """嘉靖本实列杨修违禁事七件，毛本删其中『教曹植斩门吏出』一件，使因果更集中。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """毛本浓缩杨修死因，节奏更紧。"""@zh .

sg:sg_var_060 a :VariantReading, :PlotVariant ;
    rdfs:label "庞德抬榇·箭射关羽"@zh ;
    :inMaoChapter "74"^^xsd:integer ;
    :maobenText """庞德箭射关羽左臂，于禁恐其成大功鸣金收军。"""@zh ;
    :jiajingbenText """嘉靖本射关羽左臂同，但多写关羽『拔箭』『怒欲追击』细节；于禁『嫉贤妒能』动机更明显。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本于禁妒功刻画较直露。"""@zh .

sg:sg_var_061 a :VariantReading, :PlotVariant ;
    rdfs:label "刮骨疗毒·医者是否华佗"@zh ;
    :inMaoChapter "75"^^xsd:integer ;
    :maobenText """华佗亲自为关羽刮骨疗毒。"""@zh ;
    :jiajingbenText """同作华佗（但史实华佗已于建安十三年被曹操杀，此处为演义共同虚构）。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """两本都错——时间线矛盾（华佗已死十年），属于共同史误。"""@zh .

sg:sg_var_062 a :VariantReading, :MaobenAddition ;
    rdfs:label "徐公明大战沔水·关公与徐晃叙旧"@zh ;
    :inMaoChapter "76"^^xsd:integer ;
    :maobenText """（徐晃曰：『忆昔相从，多蒙教诲……』关公与徐晃对答较简）"""@zh ;
    :jiajingbenText """徐晃先与关公叙旧『壮年相从，多蒙教诲，晃不敢忘』，然后变脸回顾众将：『谁能取关某首级？……』"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本『先叙旧再翻睑』戏剧性更强，毛本略压缩。"""@zh .

sg:sg_var_063 a :VariantReading, :MaobenAddition ;
    rdfs:label "玉泉山关公显圣·『还我头来』"@zh ;
    :inMaoChapter "77"^^xsd:integer ;
    :maobenText """（关公魂至玉泉山，大呼『还我头来』，普静点化）"""@zh ;
    :jiajingbenText """（同有『还我头来』，但多普静一段因果论：『昔非今是，一切休论；后果前因，彼此不爽……』）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本普静点化语更长，见果报思想；毛本精简。"""@zh .

sg:sg_var_064 a :VariantReading, :StylisticRewrite ;
    rdfs:label "治风疾神医身死·曹操杀华佗病因"@zh ;
    :inMaoChapter "78"^^xsd:integer ;
    :maobenText """华佗要开颅治风疾，曹操疑其害己，下狱杀之。"""@zh ;
    :jiajingbenText """同；但多华歆推荐华佗的大段赞辞，以及曹操狱中赠华佗『越女剑』之细节，毛本无。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本曹操赐剑、后又反悔的情节更显反复无常。"""@zh .

sg:sg_var_065 a :VariantReading, :MaobenAddition ;
    rdfs:label "曹操临终·分香卖履"@zh ;
    :inMaoChapter "78"^^xsd:integer ;
    :maobenText """（曹操临终嘱托简）"""@zh ;
    :jiajingbenText """多曹操嘱诸妾『勤习女工，多造丝履，卖之可以自给』一段（即著名的『分香卖履』），毛本删去。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """『分香卖履』见《三国志》注引《曹瞒传》，最见曹操真性情；毛本删之，使其枭雄末路更刻板。"""@zh .

sg:sg_var_066 a :VariantReading, :PoetryVariant ;
    rdfs:label "兄逼弟曹植赋诗·七步诗字句差异"@zh ;
    :inMaoChapter "79"^^xsd:integer ;
    :maobenText """煮豆燃豆萁，豆在釜中泣。本是同根生，相煎何太急！"""@zh ;
    :jiajingbenText """煮豆燃豆萁，豆在釜中泣。本是同根生，相煎何太急！（四句同）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """四句版为演义两本共有；世传六句版（『煮豆持作羹……』）见《世说新语》，演义均不取。"""@zh .

sg:sg_var_067 a :VariantReading, :OrthographicVariant ;
    rdfs:label "急兄仇张飞遇害·刺杀者姓名"@zh ;
    :inMaoChapter "81"^^xsd:integer ;
    :maobenText """范疆、张达"""@zh ;
    :jiajingbenText """范强、张达（『强/疆』字异）"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本作『范强』（与《三国志·张飞传》一致）；毛本作『范疆』为形近之误，后世沿袭为通名。"""@zh .

sg:sg_var_068 a :VariantReading, :StylisticRewrite ;
    rdfs:label "陆逊营烧·八阵图·黄承彦出迎"@zh ;
    :inMaoChapter "84"^^xsd:integer ;
    :maobenText """（黄承彦引陆逊出八阵图）"""@zh ;
    :jiajingbenText """多孔明岳父黄承彦自称『老夫平生好善，不忍将军陷没于此』一段说辞，毛本压缩。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本黄承彦有形象，毛本功能性出场。"""@zh .

sg:sg_var_069 a :VariantReading, :StylisticRewrite ;
    rdfs:label "刘先主遗诏托孤·『君可自为成都之主』"@zh ;
    :inMaoChapter "85"^^xsd:integer ;
    :maobenText """（先主）抚其背曰：『君才十倍曹丕……若嗣子可辅则辅之；如其不才，君可自为成都之主。』"""@zh ;
    :jiajingbenText """『君才十倍曹丕……若嗣子可辅则辅之；如其不才，君可自为成都之主。』两本同；但嘉靖本孔明『汗流遍体，手足失措』反应描写更细。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """托孤语为两本共同争议焦点（康熙以之为『谲诈』），但心理描写嘉靖本更重。"""@zh .

sg:sg_var_070 a :VariantReading, :StylisticRewrite ;
    rdfs:label "七擒孟获·孟获与孔明对话"@zh ;
    :inMaoChapter "90"^^xsd:integer ;
    :maobenText """（七擒之后）获垂泪言曰：『七擒七纵，自古未尝有也……丞相天威，南人不复反矣！』"""@zh ;
    :jiajingbenText """多孟获被擒后仍强辩之语，七擒过程比毛本稍详（如秃龙洞、木鹿大王段落更繁）。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本南征篇幅更长，包含更多西南地理风物。"""@zh .

sg:sg_var_071 a :VariantReading, :StylisticRewrite ;
    rdfs:label "孔明初上出师表·字句差异"@zh ;
    :inMaoChapter "91"^^xsd:integer ;
    :maobenText """『臣本布衣，躬耕于南阳……』"""@zh ;
    :jiajingbenText """出师表文本基本同诸葛亮本集，两本差异不大；但嘉靖本表前多孔明夜读表文的场景描写。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """两本对《出师表》均忠实保留原文。"""@zh .

sg:sg_var_072 a :VariantReading, :PlotVariant ;
    rdfs:label "孔明智退司马懿·空城计来源"@zh ;
    :inMaoChapter "95"^^xsd:integer ;
    :maobenText """（空城计情节）"""@zh ;
    :jiajingbenText """空城计情节与毛本同。但据裴注《三国志》引郭冲『五事』，空城计乃郭冲所记传闻，史实无之，两本共同虚构。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """空城计在两本都有，属共同移接（故事原型为赵云偃旗息鼓、或文聘事）。"""@zh .

sg:sg_var_073 a :VariantReading, :StylisticRewrite ;
    rdfs:label "孔明挥泪斩马谡·蒋琬求情"@zh ;
    :inMaoChapter "96"^^xsd:integer ;
    :maobenText """蒋琬求『今天下未定而戮智计之士，岂不惜乎！』孔明流涕答『孙武所以能制胜于天下者，用法明也』。"""@zh ;
    :jiajingbenText """（同）但多孔明回想刘备遗言『马谡言过其实，不可大用』一段自责，毛本亦有。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """两本此处基本一致。"""@zh .

sg:sg_var_074 a :VariantReading, :MaobenAddition ;
    rdfs:label "五丈原·禳星北斗"@zh ;
    :inMaoChapter "104"^^xsd:integer ;
    :maobenText """（孔明祈禳北斗，若七日内主灯不灭则寿可增一纪；被魏延扑灭）"""@zh ;
    :jiajingbenText """同有祈禳，但多孔明自言『吾本欲竭忠尽力，恢复中原，重兴汉室，奈天意如此』一段抒情自白，毛本压缩。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本孔明临终悲情更浓。"""@zh .

sg:sg_var_075 a :VariantReading, :MaobenAddition ;
    rdfs:label "死诸葛走活仲达·司马懿『吾有头否』"@zh ;
    :inMaoChapter "104"^^xsd:integer ;
    :maobenText """（司马懿奔逃后问左右：『吾头尚在否？』）"""@zh ;
    :jiajingbenText """同有此语；但嘉靖本多司马懿『以手摸头曰：『我有头否？』』后又自叹『吾便料生，不便料死也』。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """两本都有此戏剧性桥段。"""@zh .

sg:sg_var_076 a :VariantReading, :MaobenAddition ;
    rdfs:label "哭祖庙一王死孝·刘谌妻子自尽"@zh ;
    :inMaoChapter "118"^^xsd:integer ;
    :maobenText """（北地王刘谌哭昭烈庙，先杀妻子，然后自杀）"""@zh ;
    :jiajingbenText """多刘谌妻崔氏『伏剑而死』的详细描写（『妾请先死，王死未迟』），毛本略为一句。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """嘉靖本崔氏有节烈女子形象，毛本极简。"""@zh .

sg:sg_var_077 a :VariantReading, :PoetryVariant ;
    rdfs:label "结尾古风·总结史诗的长诗"@zh ;
    :inMaoChapter "120"^^xsd:integer ;
    :maobenText """（结尾古风从『高祖斩蛇起义』一直写到『三分归一统』，共约170句）"""@zh ;
    :jiajingbenText """古风结尾更简，且无『纷纷世事无穷尽，天数茫茫不可逃。鼎足三分已成梦，后人凭吊空牢骚』这一末四句。"""@zh ;
    :comparedInEditions sg:edition_maozonggang, sg:edition_jiajing ;
    :scholarlySignificance """毛本在结尾诗后补入『鼎足三分已成梦，后人凭吊空牢骚』，作为全书史观定调，强化『天数论』与幻灭感。"""@zh .

# ---------- Chapter（回目个体）——毛本120回 + 嘉靖本240则 ----------

sg:mao_chapter_001 a :Chapter ;
    rdfs:label "第1回 宴桃园豪杰三结义，斩黄巾英雄首立功"@zh ;
    :chapterNumber "1"^^xsd:integer ;
    :belongsToEdition sg:edition_maozonggang ;
    :correspondsToSection sg:jia_section_001, sg:jia_section_002 .

sg:jia_section_001 a :Chapter ;
    rdfs:label "第1則 祭天地桃园结义"@zh ;
    :chapterNumber "1"^^xsd:integer ;
    :belongsToEdition sg:edition_jiajing ;
    :correspondsToChapter sg:mao_chapter_001 .

sg:jia_section_002 a :Chapter ;
    rdfs:label "第2則 刘玄德斩寇立功"@zh ;
    :chapterNumber "2"^^xsd:integer ;
    :belongsToEdition sg:edition_jiajing ;
    :correspondsToChapter sg:mao_chapter_001 .

sg:mao_chapter_002 a :Chapter ;
    rdfs:label "第2回 张翼德怒鞭督邮，何国舅谋诛宦竖"@zh ;
    :chapterNumber "2"^^xsd:integer ;
    :belongsToEdition sg:edition_maozonggang ;
    :correspondsToSection sg:jia_section_003, sg:jia_section_004 .

sg:jia_section_003 a :Chapter ;
    rdfs:label "第3則 安喜张飞鞭督邮"@zh ;
    :chapterNumber "3"^^xsd:integer ;
    :belongsToEdition sg:edition_jiajing ;
    :correspondsToChapter sg:mao_chapter_002 .

sg:jia_section_004 a :Chapter ;
    rdfs:label "第4則 何进谋杀十常侍"@zh ;
    :chapterNumber "4"^^xsd:integer ;
    :belongsToEdition sg:edition_jiajing ;
    :correspondsToChapter sg:mao_chapter_002 .

sg:mao_chapter_003 a :Chapter ;
    rdfs:label "第3回 议温明董卓叱丁原，餽金珠李肃说吕布"@zh ;
    :chapterNumber "3"^^xsd:integer ;
    :belongsToEdition sg:edition_maozonggang ;
    :correspondsToSection sg:jia_section_005, sg:jia_section_006 .

sg:jia_section_005 a :Chapter ;
    rdfs:label "第5則 董卓议立陈留王"@zh ;
    :chapterNumber "5"^^xsd:integer ;
    :belongsToEdition sg:edition_jiajing ;
    :correspondsToChapter sg:mao_chapter_003 .

sg:jia_section_006 a :Chapter ;
    rdfs:label "第6則 吕布刺杀丁建阳"@zh ;
    :chapterNumber "6"^^xsd:integer ;
    :belongsToEdition sg:edition_jiajing ;
    :correspondsToChapter sg:mao_chapter_003 .

sg:mao_chapter_004 a :Chapter ;
    rdfs:label "第4回 废汉帝陈留为皇，谋董贼孟德献刀"@zh ;
    :chapterNumber "4"^^xsd:integer ;
    :belongsToEdition sg:edition_maozonggang ;
    :correspondsToSection sg:jia_section_007, sg:jia_section_008 .

sg:jia_section_007 a :Chapter ;
    rdfs:label "第7則 废汉君董卓弄权"@zh ;
    :chapterNumber "7"^^xsd:integer ;
    :belongsToEdition sg:edition_jiajing ;
    :correspondsToChapter sg:mao_chapter_004 .

sg:jia_section_008 a :Chapter ;
    rdfs:label "第8則 曹孟德谋杀董卓"@zh ;
    :chapterNumber "8"^^xsd:integer ;
    :belongsToEdition sg:edition_jiajing ;
    :correspondsToChapter sg:mao_chapter_004 .

sg:mao_chapter_005 a :Chapter ;
    rdfs:label "第5回 发矫诏诸镇应曹公，破关兵三英战吕布"@zh ;
    :chapterNumber "5"^^xsd:integer ;
