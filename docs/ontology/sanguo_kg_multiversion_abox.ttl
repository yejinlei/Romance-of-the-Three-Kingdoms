# ============================================================
# 三国演义本体论 ABox 实例层（多版本 / 异文 / 学者 / 评点 / 回目）
# 与 sanguo_kg_ontology.ttl (TBox) 配套使用
# 自动生成于 2026-10-26
# 数据版本：12 版本 · 77 核心异文 · 24 位学者 · 5 条评点传承
#           · 嘉靖240則 ↔ 毛本120回 回目映射
# ============================================================

# ---------- VersionFamily（版本家族） ----------

sg:family_yanyi a :VersionFamily ;
    rdfs:label "演义系"@zh ;
    skos:note """24卷240则系统；以嘉靖壬午本、周曰校本、夏振宇本为代表；文人刊本。"""@zh .

sg:family_zhizhuan_fan a :VersionFamily ;
    rdfs:label "志传繁本系统"@zh ;
    skos:note """20卷240段；上图下文；含花关索故事；以叶逢春本、余象斗双峰堂本为代表。"""@zh .

sg:family_zhizhuan_jian a :VersionFamily ;
    rdfs:label "志传简本系统"@zh ;
    skos:note """文字简净；以黄正甫本、刘龙田本、朱鼎臣本为代表；或为更早民间形态。"""@zh .

sg:family_pingdian a :VersionFamily ;
    rdfs:label "评点系"@zh ;
    skos:note """将240则合为120回、加双题回目与评点；以李卓吾评本、钟伯敬评本、毛宗岗本为代表。"""@zh .

sg:family_modern a :VersionFamily ;
    rdfs:label "现代整理本"@zh ;
    skos:note """以毛本为底本，参照明刊诸本校勘标点；人文社本、中华书局汇评本、沈伯俊校理本。"""@zh .

sg:family_sequel a :VersionFamily ;
    rdfs:label "续书翻案"@zh ;
    skos:note """后世续书与反案之作；如周大荒《反三国演义》。"""@zh .

:parallelTo a owl:SymmetricProperty, owl:ObjectProperty .

sg:family_yanyi     :parallelTo sg:family_zhizhuan_fan .
sg:family_yanyi     :parallelTo sg:family_zhizhuan_jian .

# ---------- Edition（版本个体） ----------

sg:edition_jiajing a :Edition ;
    rdfs:label "嘉靖壬午本《三國志通俗演義》"@zh ;
    :shortName "嘉靖本"@zh ;
    :belongsToFamily sg:family_yanyi ;
    :editionYear "1522"^^xsd:gYear ;
    :publisher "明嘉靖元年刻本"@zh ;
    :survivalState "全本（影印存世）"@zh ;
    :chapterDivision "24 卷 240 則"@zh ;
    dc:description """現存最早刻本；240 則單題七言；尊曹傾向明顯；無《臨江仙》開篇；曹操形象未被臉譜化；含「孔明燒魏延於上方谷」等被毛本刪去之段落。"""@zh ;
    :hasFullText false^^xsd:boolean .

sg:edition_zhouyuexiao a :Edition ;
    rdfs:label "周曰校本《新刊校正古本大字音釋三國志通俗演義》"@zh ;
    :shortName "周曰校本"@zh ;
    :belongsToFamily sg:family_yanyi ;
    :editionYear "1591"^^xsd:gYear ;
    :publisher "明萬曆十九年金陵周曰校萬卷樓刊"@zh ;
    :survivalState "全本（有影印，識典古籍在線）"@zh ;
    :chapterDivision "12 卷 240 則"@zh ;
    dc:description """演義系代表本；增補插圖、音注、釋義、考證；與嘉靖本同屬演義系統，文字高度一致。"""@zh ;
    :hasFullText false^^xsd:boolean .

sg:edition_yefengchun a :Edition ;
    rdfs:label "葉逢春本《新刊通俗演義三國志傳》"@zh ;
    :shortName "葉逢春本"@zh ;
    :belongsToFamily sg:family_zhizhuan_fan ;
    :editionYear "1548"^^xsd:gYear ;
    :publisher "明嘉靖二十七年建陽葉逢春刊"@zh ;
    :survivalState "殘本（分藏數館）"@zh ;
    :chapterDivision "10 卷 240 段"@zh ;
    dc:description """志傳系統最早刻本；獨有『花關索』四傳（出身/征西川/下荊州/認父）；上圖下文版式。"""@zh ;
    :hasFullText false^^xsd:boolean .

sg:edition_yuxiangdou a :Edition ;
    rdfs:label "余象斗雙峰堂本《音釋補遺按鑑批點三國志傳》"@zh ;
    :shortName "余象斗本"@zh ;
    :belongsToFamily sg:family_zhizhuan_fan ;
    :editionYear "1592"^^xsd:gYear ;
    :publisher "明萬曆二十年建陽余象斗雙峰堂刊"@zh ;
    :survivalState "全本（英國博物院/早稻田藏）"@zh ;
    :chapterDivision "20 卷"@zh ;
    dc:description """開『評林』本之風；余氏自加評點；葉逢春本系統繁本代表。"""@zh ;
    :hasFullText false^^xsd:boolean .

sg:edition_huangzhengfu a :Edition ;
    rdfs:label "黃正甫本《新刻考訂按鑑通俗演義全像三國志傳》"@zh ;
    :shortName "黃正甫本"@zh ;
    :belongsToFamily sg:family_zhizhuan_jian ;
    :editionYear "1623"^^xsd:gYear ;
    :publisher "明天啟三年閩建黃正甫刊"@zh ;
    :survivalState "全本（日本內閣文庫藏）"@zh ;
    :chapterDivision "20 卷 240 則"@zh ;
    dc:description """志傳系統簡本；文字極簡淨；與繁本（余象斗）孰先孰後學界仍有爭論（小川環樹等主簡本為先）。"""@zh ;
    :hasFullText false^^xsd:boolean .

sg:edition_lizhuowu a :Edition ;
    rdfs:label "李卓吾評本《李卓吾先生批評三國志》"@zh ;
    :shortName "李卓吾評本"@zh ;
    :belongsToFamily sg:family_pingdian ;
    :editionYear "~1607"^^xsd:gYear ;
    :publisher "明萬曆間吳觀明容與堂刊"@zh ;
    :survivalState "全本"@zh ;
    :chapterDivision "120 回（首合 240 則為 120 回）"@zh ;
    dc:description """首次將 240 則合併為 120 回；回目由單題改為雙題；葉晝偽託李贄評點；尊劉貶曹傾向加強。"""@zh ;
    :hasFullText false^^xsd:boolean .

sg:edition_zhongbojing a :Edition ;
    rdfs:label "鍾伯敬評本《鍾伯敬先生批評三國志》"@zh ;
    :shortName "鍾伯敬評本"@zh ;
    :belongsToFamily sg:family_pingdian ;
    :editionYear "~1627"^^xsd:gYear ;
    :publisher "明天啟間積慶堂刊"@zh ;
    :survivalState "全本"@zh ;
    :chapterDivision "120 回"@zh ;
    dc:description """繼李評本之評點系統；評語較李評簡潔；明末清初流傳較廣。"""@zh ;
    :hasFullText false^^xsd:boolean .

sg:edition_liyu a :Edition ;
    rdfs:label "李笠翁評本《笠翁批評三國志》"@zh ;
    :shortName "李漁評本"@zh ;
    :belongsToFamily sg:family_pingdian ;
    :editionYear "~1670"^^xsd:gYear ;
    :publisher "清康熙間刊"@zh ;
    :survivalState "全本"@zh ;
    :chapterDivision "120 回"@zh ;
    dc:description """毛宗崗同時代之評本；李漁為清初戲曲大家；評點偏向小說結構與文法。"""@zh ;
    :hasFullText false^^xsd:boolean .

sg:edition_maozonggang a :Edition ;
    rdfs:label "毛宗崗評本《四大奇書第一種——三國志演義》"@zh ;
    :shortName "毛本（通行本）"@zh ;
    :belongsToFamily sg:family_pingdian ;
    :editionYear "1679"^^xsd:gYear ;
    :publisher "清康熙十八年醉畊堂刊（毛綸、毛宗崗父子評改）"@zh ;
    :survivalState "全本（通行本）"@zh ;
    :chapterDivision "120 回"@zh ;
    dc:description """現今通行本；首冠楊慎《臨江仙·滾滾長江東逝水》；整頓回目為對偶聯語；刪改嘉靖本尊曹字句，強化尊劉貶曹；刪去『上方谷燒魏延』等段落；加毛氏回前總評、夾批；此本一出『一切舊本乃不復行』。本站在線全文即毛本（590,968 字）。"""@zh ;
    :hasFullText true^^xsd:boolean .

sg:edition_renwen a :Edition ;
    rdfs:label "人民文學出版社校訂本"@zh ;
    :shortName "人文社本"@zh ;
    :belongsToFamily sg:family_modern ;
    :editionYear "1953"^^xsd:gYear ;
    :publisher "人民文學出版社（初版顧學頡等整理，1973 第三版）"@zh ;
    :survivalState "全本"@zh ;
    :chapterDivision "120 回"@zh ;
    dc:description """以毛本為底本，參照明嘉靖本、清一些評本校勘標點；大陸最通行現代整理本；國內發行量最大。"""@zh ;
    :hasFullText false^^xsd:boolean .

sg:edition_shenbojun a :Edition ;
    rdfs:label "沈伯俊校理本《三國演義（新校理本）》"@zh ;
    :shortName "沈伯俊校理本"@zh ;
    :belongsToFamily sg:family_modern ;
    :editionYear "1992"^^xsd:gYear ;
    :publisher "江蘇古籍出版社/巴蜀書社多版"@zh ;
    :survivalState "全本"@zh ;
    :chapterDivision "120 回"@zh ;
    dc:description """當代三國權威沈伯俊以毛本為底本、參校多個明刊本之校理本；對毛本地理/官職/人物訛誤多所校正。"""@zh ;
    :hasFullText false^^xsd:boolean .

sg:edition_fan a :Edition ;
    rdfs:label "反三國演義（周大荒）"@zh ;
    :shortName "反三國"@zh ;
    :belongsToFamily sg:family_sequel ;
    :editionYear "1924"^^xsd:gYear ;
    :publisher "民國時期初刊"@zh ;
    :survivalState "全本"@zh ;
    :chapterDivision "60 回"@zh ;
    dc:description """續書/翻案之作；為蜀漢翻案，令劉備諸葛亮統一天下；結尾『薦杜預老將獻新謀』不同毛本。"""@zh ;
    :hasFullText false^^xsd:boolean .

